.hero {
  background: linear-gradient(135deg, #244B36, #173628);
  border-radius: var(--sr-radius); padding: 40rpx; margin-bottom: 24rpx;
  display: flex; flex-direction: column;
}
.hero__label { font-size: 24rpx; color: rgba(255,255,255,0.75); }
.hero__time { font-size: 64rpx; font-weight: 800; color: #E0B95C; margin: 8rpx 0 12rpx; letter-spacing: 2rpx; }
.hero__tip { font-size: 24rpx; color: rgba(255,255,255,0.85); line-height: 1.7; }

.note { display: flex; align-items: flex-start; padding: 14rpx 0; }
.note__dot { flex-shrink: 0; width: 28rpx; font-size: 28rpx; color: var(--sr-seal); font-weight: 700; }
.note__text { flex: 1; font-size: 26rpx; color: var(--sr-text-sub); line-height: 1.75; }

.foot { text-align: center; font-size: 24rpx; color: var(--sr-danger); padding: 24rpx 0 8rpx; }
