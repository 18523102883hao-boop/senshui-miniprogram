/* 门票商品详情 */
.detail-page { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }


.gallery { height: 420rpx; border-radius: var(--sr-radius); overflow: hidden; margin-bottom: 24rpx; }
.gallery__img { width: 100%; height: 420rpx; }
.cover { width: 100%; height: 420rpx; border-radius: var(--sr-radius); display: block; margin-bottom: 24rpx; background: var(--sr-bg-sunken); }

.price { display: flex; align-items: baseline; }
.price__cur { font-size: 28rpx; color: var(--sr-seal); font-weight: 700; }
.price__num { font-size: 60rpx; font-weight: 800; color: var(--sr-seal); line-height: 1; }
.price__market { font-size: 24rpx; color: var(--sr-text-weak); text-decoration: line-through; margin-left: 16rpx; }
.name { display: block; font-size: 34rpx; font-weight: 700; color: var(--sr-text); margin-top: 18rpx; }
.highlight { display: block; font-size: 24rpx; color: var(--sr-primary); margin-top: 10rpx; }
.tags { display: flex; flex-wrap: wrap; margin-top: 18rpx; }
.tag { font-size: 21rpx; color: var(--sr-primary); background: var(--sr-primary-weak); padding: 8rpx 18rpx; border-radius: 8rpx; margin-right: 12rpx; margin-bottom: 8rpx; }

.para { display: block; font-size: 27rpx; color: var(--sr-text-sub); line-height: 1.7; margin-top: 16rpx; }
.sub-title { display: block; font-size: 27rpx; font-weight: 700; color: var(--sr-text); margin-top: 26rpx; }

.li { display: flex; align-items: flex-start; padding: 10rpx 0; }
.li__dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--sr-text-weak); margin: 14rpx 18rpx 0 0; flex-shrink: 0; }
.li__dot--in { background: var(--sr-primary); }
.li__dot--out { background: var(--sr-text-weak); }
.li__dot--warn { background: var(--sr-seal); }
.li__text { flex: 1; font-size: 25rpx; color: var(--sr-text-sub); line-height: 1.7; }

.kv { display: flex; align-items: flex-start; padding: 16rpx 0; border-bottom: 1rpx solid var(--sr-line); }
.kv:last-child { border-bottom: none; }
.kv__k { width: 160rpx; flex-shrink: 0; font-size: 25rpx; color: var(--sr-text-weak); }
.kv__v { flex: 1; font-size: 25rpx; color: var(--sr-text); line-height: 1.6; }

.tail { font-size: 21rpx; color: var(--sr-text-weak); text-align: center; padding: 24rpx 0 20rpx; line-height: 1.6; }

.bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  display: flex; align-items: center;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--sr-bg-card); box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.bar__call { display: flex; flex-direction: column; align-items: center; font-size: 20rpx; color: var(--sr-text-sub); margin-right: 28rpx; }
.bar__icon { width: 40rpx; height: 40rpx; margin-bottom: 4rpx; }
.bar__price { flex: 1; display: flex; align-items: baseline; }
.bar__cur { font-size: 24rpx; color: var(--sr-seal); font-weight: 700; }
.bar__num { font-size: 44rpx; font-weight: 800; color: var(--sr-seal); line-height: 1; }
.bar__cta {
  padding: 24rpx 60rpx; border-radius: 44rpx;
  background: var(--sr-primary); color: #fff; font-size: 30rpx; font-weight: 700;
}


/* 常驻底部导航避让 */
.sr-page { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)) !important; }

/* 底部操作栏 + 常驻导航同时存在：操作栏上移，页面留双份空间 */
.bar { bottom: calc(130rpx + env(safe-area-inset-bottom)); }
.detail-page { padding-bottom: calc(310rpx + env(safe-area-inset-bottom)) !important; }
