.tabs { display: flex; margin-bottom: 24rpx; }
.tab {
  flex: 1; text-align: center; padding: 16rpx 0;
  font-size: 26rpx; color: var(--sr-text-sub);
}
.tab--on { color: var(--sr-primary); font-weight: 700; border-bottom: 4rpx solid var(--sr-primary); }


.tcard {
  background: var(--sr-bg-card); border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow); padding: 28rpx 32rpx; margin-bottom: 20rpx;
  border-left: 8rpx solid var(--sr-primary);
}
.tcard__head { display: flex; align-items: center; justify-content: space-between; }
.tcard__name { font-size: 30rpx; font-weight: 700; color: var(--sr-text); }
.tcard__seq { font-size: 22rpx; color: var(--sr-text-weak); }
.tcard__no { display: block; font-size: 22rpx; color: var(--sr-text-weak); margin-top: 10rpx; }
.tcard__foot { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; }
.tcard__date { font-size: 23rpx; color: var(--sr-text-sub); }
.tcard__cta { font-size: 24rpx; color: var(--sr-primary); font-weight: 600; }


.mask { position: fixed; inset: 0; z-index: 100; background: rgba(10, 14, 12, 0.7); display: flex; align-items: center; justify-content: center; }
.code {
  width: 78%; background: var(--sr-bg-card); border-radius: var(--sr-radius-lg);
  padding: 48rpx 40rpx; display: flex; flex-direction: column; align-items: center;
}
.code__title { font-size: 32rpx; font-weight: 800; color: var(--sr-text); }
.code__no { font-size: 22rpx; color: var(--sr-text-weak); margin-top: 10rpx; }
.code__box {
  width: 400rpx; height: 400rpx; box-sizing: border-box; margin-top: 28rpx; padding: 20rpx;
  background: #fff; border: 1rpx solid var(--sr-line); border-radius: var(--sr-radius);
  display: flex; align-items: center; justify-content: center;
}
.code__qr-canvas { width: 360rpx; height: 360rpx; }
.code__qr-error {
  width: 100%; height: 100%; border-radius: var(--sr-radius-sm); background: var(--sr-bg-sunken);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.code__qr-error-title { font-size: 26rpx; color: var(--sr-text); font-weight: 600; }
.code__qr-error-desc { font-size: 22rpx; color: var(--sr-text-weak); margin-top: 10rpx; }
.code__tip { font-size: 21rpx; color: var(--sr-text-weak); margin-top: 22rpx; text-align: center; line-height: 1.6; }
.code__close { margin-top: 32rpx; padding: 16rpx 56rpx; border-radius: 40rpx; background: var(--sr-primary); color: #fff; font-size: 26rpx; font-weight: 600; }

/* 常驻底部导航避让 */
.sr-page { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)) !important; }
