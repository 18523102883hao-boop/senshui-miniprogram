<view class="sr-page sr-enter">
  <view class="tabs">
    <view class="tab {{activeTab === item.key ? 'tab--on' : ''}}"
          wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="onTabTap">
      {{item.title}}
    </view>
  </view>

  <sr-skeleton wx:if="{{loading}}" type="card" rows="3" />

  <view class="tlist" wx:if="{{!loading && visibleList.length}}">
    <view class="tcard sr-touch" hover-class="sr-touch--card" hover-stay-time="60"
          wx:for="{{visibleList}}" wx:key="ticketNo" data-no="{{item.ticketNo}}" bindtap="onTicketTap">
      <view class="tcard__head">
        <text class="tcard__name">{{item.productName}}</text>
        <text class="tcard__seq sr-num" wx:if="{{item.total > 1}}">{{item.seq}}/{{item.total}}</text>
      </view>
      <text class="tcard__no sr-num">票号 {{item.ticketNo}}</text>
      <view class="tcard__foot">
        <text class="tcard__date" wx:if="{{item.visitDate}}">使用日期 {{item.visitDate}}</text>
        <text class="tcard__cta" wx:if="{{activeTab === 'unused'}}">出示入园码 ›</text>
      </view>
    </view>
  </view>

  <sr-empty-state wx:if="{{isEmpty && !loading && !hasError}}"
                  icon="home-ticket" title="这里还没有票券"
                  desc="购票后票券会自动出现在这里"
                  actionText="去购票" bind:action="goBuy" />

  <sr-error-state wx:if="{{hasError && !loading}}" bind:retry="onRetry" />

  <!-- 入园码弹层：动态 token，90 秒失效 -->
  <view class="mask" wx:if="{{codeToken}}" bindtap="closeCode">
    <view class="code" catchtap="noop">
      <text class="code__title">入园码</text>
      <text class="code__no sr-num">{{codeTicketNo}}</text>
      <view class="code__box">
        <text class="code__token">{{codeToken}}</text>
      </view>
      <text class="code__tip">请出示给检票员扫码；{{codeExpiresIn}} 秒内有效，过期重新打开即可</text>
      <view class="code__close" bindtap="closeCode">关闭</view>
    </view>
  </view>

  <!-- 常驻底部导航：二级页面也能直接切 Tab -->
  <sr-tabbar theme="light" />
</view>
