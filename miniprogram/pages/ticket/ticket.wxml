<view class="sr-page sr-enter">
  <!-- 分类 -->
  <scroll-view class="cats" scroll-x enable-flex show-scrollbar="{{false}}">
    <view class="cat {{category === item.key ? 'cat--on' : ''}}"
          wx:for="{{categories}}" wx:key="key" data-key="{{item.key}}" bindtap="onCategoryTap">
      {{item.title}}
    </view>
  </scroll-view>

  <view class="skeleton" wx:if="{{loading}}">
    <view class="skeleton__item" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
  </view>

  <!-- 商品卡 -->
  <view class="plist" wx:if="{{!loading && products.length}}">
    <view class="pcard sr-touch" hover-class="sr-touch--card" hover-stay-time="60"
          wx:for="{{products}}" wx:key="productId" data-id="{{item.productId}}" bindtap="onProductTap">
      <image class="pcard__cover" wx:if="{{item.coverFileId}}" src="{{item.coverFileId}}" mode="aspectFill" />
      <view class="pcard__body">
        <text class="pcard__name">{{item.name}}</text>
        <text class="pcard__audience">{{item.audience}}</text>

        <view class="pcard__tags">
          <text class="tag" wx:if="{{item.refundTag}}">{{item.refundTag}}</text>
          <text class="tag" wx:if="{{item.validityText}}">{{item.validityText}}</text>
          <text class="tag">{{item.reservationRequired ? '需预约' : '无需预约'}}</text>
        </view>

        <view class="pcard__benefits">
          <text class="ben" wx:for="{{item.benefits}}" wx:key="*this" wx:for-item="b">{{b}}</text>
        </view>

        <view class="pcard__foot">
          <view class="pcard__price">
            <text class="pcard__cur">¥</text>
            <text class="pcard__num sr-num">{{item.priceText}}</text>
            <text class="pcard__market sr-num" wx:if="{{item.marketPriceText}}">¥{{item.marketPriceText}}</text>
          </view>
          <text class="pcard__cta">{{item.cta.text}} ›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 错误态：商品拉不到，但购票入口不能死 -->
  <view class="state" wx:if="{{hasError && !loading}}">
    <image class="state__icon" src="/assets/icons/status/status-warning.png" mode="aspectFit" />
    <text class="state__text">票种加载失败</text>
    <text class="state__sub">可先通过下方官方渠道购买</text>
    <view class="state__btn sr-touch" hover-class="sr-touch--cta" hover-stay-time="60" bindtap="onRetry">重新加载</view>
  </view>

  <view class="state" wx:if="{{!loading && !hasError && !products.length}}">
    <image class="state__icon" src="/assets/icons/forest/home-ticket.png" mode="aspectFit" />
    <text class="state__text">该分类暂无在售票种</text>
    <text class="state__sub">可切换分类或走官方渠道</text>
  </view>

  <!-- 外部渠道兜底 -->
  <view class="sr-card">
    <text class="sr-subtitle">其他购票渠道</text>
    <view class="sr-divider"></view>
    <view class="chan sr-touch" hover-class="sr-touch--press" hover-stay-time="60"
          wx:for="{{channels}}" wx:key="name" data-url="{{item.url}}" bindtap="copyLink">
      <view class="chan__info">
        <text class="chan__name">{{item.name}}</text>
        <text class="chan__desc">{{item.desc}}</text>
      </view>
      <text class="chan__action">复制链接 ›</text>
    </view>
    <view class="note">{{upgradeNote}}</view>
  </view>
</view>
