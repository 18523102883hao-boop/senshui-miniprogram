<view class="sr-page co-page sr-enter">
  <sr-skeleton wx:if="{{loading}}" type="card" rows="3" />

  <block wx:if="{{product && !loading}}">
    <!-- 商品摘要 -->
    <view class="sr-card sum">
      <image class="sum__cover" wx:if="{{product.coverFileId}}" src="{{product.coverFileId}}" mode="aspectFill" />
      <view class="sum__body">
        <text class="sum__name">{{product.name}}</text>
        <text class="sum__audience">{{product.audience}}</text>
        <view class="sum__price">
          <text class="sum__cur">¥</text>
          <text class="sum__num sr-num">{{product.priceText}}</text>
        </view>
      </view>
    </view>

    <!-- 数量 -->
    <view class="sr-card">
      <view class="row">
        <text class="row__label">购买数量</text>
        <view class="stepper">
          <view class="stepper__btn {{quantity <= 1 ? 'stepper__btn--off' : ''}}" bindtap="onMinus"><sr-icon name="shop-minus" theme="light" size="sm" /></view>
          <text class="stepper__val sr-num">{{quantity}}</text>
          <view class="stepper__btn {{quantity >= maxQuantity ? 'stepper__btn--off' : ''}}" bindtap="onPlus"><sr-icon name="shop-add" theme="light" size="sm" /></view>
        </view>
      </view>
      <text class="row__hint">每单限购 {{maxQuantity}} 份</text>
    </view>

    <!-- 使用日期（仅需预约商品） -->
    <view class="sr-card" wx:if="{{product.reservationRequired}}">
      <picker mode="date" value="{{visitDate}}" start="{{minDate}}" bindchange="onDateChange">
        <view class="row">
          <text class="row__label">使用日期</text>
          <text class="row__value">{{visitDate || '请选择'}} ›</text>
        </view>
      </picker>
    </view>

    <!-- 联系人 -->
    <view class="sr-card">
      <view class="row">
        <text class="row__label">联系人</text>
        <input class="row__input" placeholder="姓名（选填）" value="{{contactName}}" bindinput="onNameInput" maxlength="20" />
      </view>
      <view class="row">
        <text class="row__label">手机号</text>
        <input class="row__input" type="number" placeholder="便于联系（选填）" value="{{contactPhone}}" bindinput="onPhoneInput" maxlength="11" />
      </view>
    </view>

    <!-- 规则提示 -->
    <view class="sr-card" wx:if="{{product.refundRule}}">
      <text class="sr-subtitle">购买须知</text>
      <view class="sr-divider"></view>
      <text class="para">{{product.validityRule.desc}}</text>
      <text class="para">{{product.refundRule.summary}}</text>
      <text class="para">{{product.reservationRequired ? (leadTimeDays > 0 ? '需提前 ' + leadTimeDays + ' 天预约，按所选日期使用' : '需按所选日期使用') : '无需预约，高峰期可能排队'}}</text>
    </view>
  </block>

  <sr-error-state wx:if="{{hasError && !loading}}" bind:retry="onRetry" />

  <!-- 底部提交栏 -->
  <view class="bar" wx:if="{{product && !loading}}">
    <view class="bar__total">
      <text class="bar__label">合计</text>
      <text class="bar__cur">¥</text>
      <text class="bar__num sr-num">{{totalText}}</text>
    </view>
    <view class="bar__cta {{submitting ? 'bar__cta--off' : ''}}" bindtap="onSubmit">
      {{submitting ? '处理中…' : '确认支付'}}
    </view>
  </view>
</view>
