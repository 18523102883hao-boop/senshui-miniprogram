/* ===== 用户信息卡 =====
   与页面其余模块统一为白底卡片。
   ⚠️ <button> 在小程序里自带 display:block 与 margin:auto，直接放进 flex
   容器会把后面的内容顶开（表现为昵称飘到屏幕中间）。必须显式压掉这些默认值，
   并给信息区固定左对齐，避免继承任何居中规则。 */
.profile {
  display: flex; align-items: center;
  background: var(--sr-bg-card); border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow);
  padding: 28rpx 32rpx; margin-bottom: 24rpx;
}
.profile__avatar-btn {
  position: relative; flex-shrink: 0;
  width: 104rpx; height: 104rpx;
  padding: 0; margin: 0; line-height: normal;
  background: transparent; border-radius: 50%; overflow: visible;
}
.profile__avatar-btn::after { border: none; }
.profile__avatar {
  width: 104rpx; height: 104rpx; border-radius: 50%; display: block;
  background: var(--sr-bg-sunken);
  border: 2rpx solid var(--sr-line); box-sizing: border-box;
}
/* 编辑徽标：白底细边比深绿实心克制得多，小尺寸下不抢头像。
   位置取 45° 方向压住圆周（按方框角落定位会离圆周约 15rpx，看着像飘在外面）。 */
.profile__avatar-edit {
  position: absolute; right: 4rpx; bottom: 4rpx;
  width: 34rpx; height: 34rpx; border-radius: 50%;
  background: var(--sr-bg-card); border: 2rpx solid var(--sr-line);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
  display: flex; align-items: center; justify-content: center;
}
.profile__avatar-edit image { width: 18rpx; height: 18rpx; opacity: 0.5; }

.profile__info {
  flex: 1; min-width: 0; margin-left: 24rpx;
  display: flex; flex-direction: column; align-items: flex-start;
  text-align: left;
}
.profile__name {
  font-size: 32rpx; font-weight: 700; color: var(--sr-text);
  max-width: 100%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.profile__login {
  display: inline-flex; align-items: center; gap: 10rpx;
  margin: 16rpx 0 0; padding: 0 26rpx; height: 60rpx; line-height: 60rpx;
  font-size: 26rpx; font-weight: 600; color: #fff; background: var(--sr-primary);
  border-radius: 30rpx;
}
.profile__login::after { border: none; }
.profile__login-icon { width: 30rpx; height: 30rpx; filter: brightness(0) invert(1); }
.profile__phone-done {
  display: flex; align-items: center; gap: 8rpx;
  font-size: 24rpx; color: var(--sr-text-sub); margin-top: 10rpx;
}
.profile__done-icon { width: 28rpx; height: 28rpx; }

/* ===== 黑金会员卡 ===== */
.mcard {
  display: flex; align-items: center; justify-content: space-between;
  border-radius: var(--sr-radius-lg); padding: 40rpx; margin-bottom: 28rpx;
  box-shadow: var(--sr-shadow);
}
.mcard__title { font-size: 34rpx; font-weight: 800; color: var(--sr-gold-light); letter-spacing: 2rpx; }
.mcard__desc { display: block; font-size: 22rpx; color: rgba(247, 243, 234, 0.72); margin-top: 10rpx; }
.mcard__action {
  font-size: 26rpx; color: #173628; background: var(--sr-gold);
  padding: 14rpx 28rpx; border-radius: 34rpx; font-weight: 700;
}

/* ===== 我的服务（整行列表）===== */
.svc-list {
  background: var(--sr-bg-card); border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow); overflow: hidden; margin-bottom: 24rpx;
}
.svc { display: flex; align-items: center; padding: 30rpx 32rpx; border-bottom: 1rpx solid var(--sr-line); }
.svc:last-child { border-bottom: none; }
.svc__icon { width: 44rpx; height: 44rpx; flex-shrink: 0; }
.svc__title { flex: 1; font-size: 29rpx; font-weight: 500; color: var(--sr-text); margin-left: 22rpx; }
.svc__sub { font-size: 24rpx; color: var(--sr-gold); font-weight: 600; margin-right: 12rpx; }
.svc__arrow { width: 28rpx; height: 28rpx; opacity: 0.4; }

.legal-links { display: flex; align-items: center; justify-content: center; padding: 32rpx 0 8rpx; }
.legal-links__item { font-size: 24rpx; color: var(--sr-text-sub); }
.legal-links__sep { font-size: 24rpx; color: var(--sr-text-weak); margin: 0 16rpx; }

.staff-entry { text-align: center; font-size: 24rpx; color: var(--sr-text-weak); padding: 24rpx 0 40rpx; opacity: 0.6; }

/* 两组宫格之间的呼吸（sr-section-header 自带 24rpx 下边距） */
.svc-list + .sh { margin-top: var(--sr-gap-5); }
