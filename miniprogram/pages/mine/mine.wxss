.profile { display: flex; align-items: center; padding: 24rpx 8rpx 40rpx; }
.profile__avatar { width: 112rpx; height: 112rpx; border-radius: 56rpx; background: var(--sr-bg-sunken); }
.profile__info { margin-left: 24rpx; display: flex; flex-direction: column; }
.profile__name { font-size: 34rpx; font-weight: 700; color: var(--sr-text); }
.profile__phone {
  margin: 12rpx 0 0; padding: 0 20rpx; height: 52rpx; line-height: 52rpx;
  font-size: 24rpx; color: var(--sr-primary); background: var(--sr-primary-weak);
  border-radius: 26rpx; align-self: flex-start;
}
.profile__phone::after { border: none; }
.profile__phone-done { font-size: 24rpx; color: var(--sr-text-sub); margin-top: 8rpx; }

.mcard {
  display: flex; align-items: center; justify-content: space-between;
  background: linear-gradient(135deg, #2A4D3A, #1F3A2C);
  border-radius: var(--sr-radius); padding: 36rpx 40rpx; margin-bottom: 24rpx;
  position: relative; overflow: hidden;
}
.mcard::after {
  content: '森水'; position: absolute; right: -10rpx; bottom: -20rpx;
  font-size: 120rpx; font-weight: 800; color: rgba(255,255,255,0.05);
}
.mcard__title { font-size: 32rpx; font-weight: 700; color: #F5D98B; }
.mcard__desc { display: block; font-size: 22rpx; color: rgba(255,255,255,0.75); margin-top: 8rpx; }
.mcard__action {
  font-size: 26rpx; color: #1F3A2C; background: #F5D98B;
  padding: 12rpx 24rpx; border-radius: 30rpx; font-weight: 600; z-index: 1;
}

.grid { display: flex; flex-wrap: wrap; background: var(--sr-bg-card); border-radius: var(--sr-radius); box-shadow: var(--sr-shadow); padding: 8rpx 0; margin-bottom: 24rpx; }
.grid__item { width: 25%; box-sizing: border-box; padding: 28rpx 0; display: flex; flex-direction: column; align-items: center; }
.grid__title { font-size: 26rpx; color: var(--sr-text); }
.grid__sub { font-size: 20rpx; color: var(--sr-seal); margin-top: 6rpx; min-height: 24rpx; }

.contact { display: flex; align-items: center; justify-content: space-between; }
.contact__text { font-size: 28rpx; color: var(--sr-text); }
.contact__phone { font-size: 26rpx; color: var(--sr-primary); }

.staff-entry { text-align: center; font-size: 24rpx; color: var(--sr-text-weak); padding: 40rpx 0; }
