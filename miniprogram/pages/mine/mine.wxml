<view class="sr-page sr-page--tab sr-enter">
  <!-- 用户信息 -->
  <view class="profile">
    <button class="profile__avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="profile__avatar" src="{{userInfo.avatarUrl || '/assets/icons/forest/mine-profile.png'}}" mode="aspectFill" />
      <view class="profile__avatar-edit">
        <image src="/assets/icons/forest/edit.png" mode="aspectFit" />
      </view>
    </button>
    <view class="profile__info">
      <text class="profile__name">{{userInfo.nickName || '森水游客'}}</text>
      <button
        wx:if="{{!hasPhone}}"
        class="profile__login"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhone"
      >
        <image class="profile__login-icon" src="/assets/icons/forest/mine-phone.png" mode="aspectFit" />
        <text>手机号一键登录</text>
      </button>
      <view wx:else class="profile__phone-done">
        <image class="profile__done-icon" src="/assets/icons/status/status-success.png" mode="aspectFit" />
        <text>已登录 · {{phoneMask}}</text>
      </view>
    </view>
  </view>

  <!-- 会员卡（黑金 · 整卡可点） -->
  <view class="mcard sr-goldcard sr-gold-hairline sr-touch" hover-class="sr-touch--card" hover-stay-time="60" bindtap="goMember">
    <view class="mcard__left">
      <text class="mcard__title">森水会员卡</text>
      <text class="mcard__desc">{{member ? '有效期至 ' + member.expireText : '9.9 元 · 1000 长河令 + 生日 85 折'}}</text>
    </view>
    <text class="mcard__action">{{member ? '查看卡包' : '立即开卡'}}</text>
  </view>

  <!-- 我的行程（票券/预约/订单/卡券 · 首屏优先） -->
  <sr-section-header title="我的行程" />
  <view class="svc-list">
    <view class="svc sr-touch" hover-class="sr-touch--press" hover-stay-time="60"
          wx:for="{{tripGrid}}" wx:key="key" data-key="{{item.key}}" bindtap="onGrid">
      <image class="svc__icon" src="{{item.icon}}" mode="aspectFit" />
      <text class="svc__title">{{item.title}}</text>
      <text class="svc__sub">{{item.sub}}</text>
      <sr-icon name="chevron-right" theme="light" size="sm" />
    </view>
  </view>

  <!-- 资产与服务 -->
  <sr-section-header title="资产与服务" />
  <view class="svc-list">
    <view class="svc sr-touch" hover-class="sr-touch--press" hover-stay-time="60"
          wx:for="{{assetGrid}}" wx:key="key" data-key="{{item.key}}" bindtap="onGrid">
      <image class="svc__icon" src="{{item.icon}}" mode="aspectFit" />
      <text class="svc__title">{{item.title}}</text>
      <text class="svc__sub">{{item.sub}}</text>
      <sr-icon name="chevron-right" theme="light" size="sm" />
    </view>

    <!-- 联系前台 -->
    <view class="svc sr-touch" hover-class="sr-touch--press" hover-stay-time="60" bindtap="callFront">
      <image class="svc__icon" src="/assets/icons/forest/mine-phone.png" mode="aspectFit" />
      <text class="svc__title">联系前台</text>
      <text class="svc__sub sr-num">{{frontPhone}}</text>
      <sr-icon name="chevron-right" theme="light" size="sm" />
    </view>
  </view>

  <!-- 协议与政策（合规入口） -->
  <view class="legal-links">
    <text class="legal-links__item" bindtap="goAgreement">用户服务协议</text>
    <text class="legal-links__sep">·</text>
    <text class="legal-links__item" bindtap="goPrivacy">隐私政策</text>
  </view>

  <!-- 员工模式（隐藏入口） -->
  <view class="staff-entry" bindtap="goStaff">员工模式</view>

  <!-- 隐私授权弹窗（调用手机号/头像前由微信触发） -->
  <privacy-popup />
</view>
