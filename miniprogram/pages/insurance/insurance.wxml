<view class="insurance-page sr-page sr-enter">
  <view class="insurance-hero">
    <text class="insurance-hero__eyebrow">CANYONING INSURANCE</text>
    <text class="insurance-hero__title">下水前，先把保障准备好</text>
    <text class="insurance-hero__desc">溪降属于户外水上活动，建议每位参与者在出行前完成保险购买。</text>
  </view>

  <view class="steps sr-card">
    <view class="steps__head">
      <text class="steps__title">3 步完成购买</text>
      <text class="steps__note">约 2 分钟</text>
    </view>
    <view class="steps__list">
      <view class="step">
        <text class="step__num sr-num">01</text>
        <text class="step__text">点击二维码</text>
      </view>
      <view class="step">
        <text class="step__num sr-num">02</text>
        <text class="step__text">全屏后长按识别</text>
      </view>
      <view class="step">
        <text class="step__num sr-num">03</text>
        <text class="step__text">在保游网完成投保</text>
      </view>
    </view>
  </view>

  <view class="qr-section sr-card">
    <view class="qr-section__head">
      <view>
        <text class="qr-section__badge">第三方服务 · 保游网</text>
        <text class="qr-section__title">溪降保险购买码</text>
      </view>
      <text class="qr-section__status">官方投保页</text>
    </view>

    <view class="qr-preview sr-touch"
          hover-class="sr-touch--card"
          hover-stay-time="60"
          bindtap="previewQr"
          aria-role="button"
          aria-label="点击放大保险购买二维码">
      <image class="qr-preview__image"
             src="{{qrImage}}"
             mode="widthFix"
             show-menu-by-longpress />
      <view class="qr-preview__action">点击放大二维码</view>
    </view>

    <view class="recognize-tip">
      <text class="recognize-tip__title">全屏后长按识别</text>
      <text class="recognize-tip__desc">点击上方图片，在全屏预览中长按二维码，选择「识别图中二维码」。</text>
    </view>

    <button class="copy-link sr-btn sr-btn--ghost sr-touch"
            hover-class="sr-touch--cta"
            hover-stay-time="60"
            bindtap="copyPurchaseLink">
      无法识别？复制投保链接
    </button>

    <view class="manual-copy" wx:if="{{manualCopyVisible}}">
      <text class="manual-copy__label">系统剪贴板暂不可用，请长按下方链接复制</text>
      <text class="manual-copy__url"
            user-select="true"
            selectable="true">{{purchaseUrl}}</text>
    </view>
  </view>

  <view class="notice sr-card">
    <text class="notice__title">购买前请确认</text>
    <view class="notice__item">
      <text class="notice__index sr-num">1</text>
      <text class="notice__text">请为每位实际参与溪降的游客购买，并如实填写投保信息。</text>
    </view>
    <view class="notice__item">
      <text class="notice__index sr-num">2</text>
      <text class="notice__text">支付前请仔细确认承保范围、免责条款和保险生效时间。</text>
    </view>
    <view class="notice__item">
      <text class="notice__index sr-num">3</text>
      <text class="notice__text">投保、支付、保单与理赔由第三方保游网及其合作保险机构提供；森水长河仅提供购买入口。</text>
    </view>
  </view>

  <view class="report sr-touch"
        hover-class="sr-touch--press"
        hover-stay-time="60"
        bindtap="callReport"
        aria-role="button"
        aria-label="拨打保险出险报案电话">
    <view>
      <text class="report__label">出险报案电话</text>
      <text class="report__phone sr-num">{{reportPhoneText}}</text>
    </view>
    <text class="report__action">拨打 ›</text>
  </view>

  <privacy-popup />
</view>
