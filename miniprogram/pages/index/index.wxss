.notice {
  display: flex; align-items: center;
  background: var(--sr-primary-weak);
  border-radius: var(--sr-radius-sm);
  padding: 20rpx 24rpx; margin-bottom: 24rpx;
}
.notice__tag {
  flex-shrink: 0; font-size: 22rpx; color: #fff;
  background: var(--sr-seal); border-radius: 6rpx;
  padding: 2rpx 12rpx; margin-right: 16rpx;
}
.notice__text { font-size: 26rpx; color: var(--sr-primary); }

/* 会员卡主推 */
.promo {
  display: flex; align-items: center; justify-content: space-between;
  background: linear-gradient(135deg, #2A4D3A, #1F3A2C);
  border-radius: var(--sr-radius); padding: 32rpx 36rpx; margin-bottom: 28rpx;
  box-shadow: var(--sr-shadow);
}
.promo__left { display: flex; flex-direction: column; }
.promo__badge {
  align-self: flex-start; font-size: 20rpx; font-weight: 700; color: #1F3A2C;
  background: #F5D98B; border-radius: 6rpx; padding: 2rpx 12rpx;
}
.promo__title { font-size: 34rpx; font-weight: 800; color: #F5D98B; margin-top: 12rpx; }
.promo__desc { font-size: 22rpx; color: rgba(255,255,255,0.8); margin-top: 8rpx; }
.promo__right { display: flex; flex-direction: column; align-items: flex-end; }
.promo__price { font-size: 52rpx; font-weight: 800; color: #fff; line-height: 1; }
.promo__cta { font-size: 22rpx; color: #F5D98B; margin-top: 10rpx; }

.sec-title { display: block; font-size: 28rpx; font-weight: 700; color: var(--sr-text); margin: 8rpx 4rpx 16rpx; }

.quick { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.quick__item {
  flex: 1; position: relative;
  background: var(--sr-bg-card); border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow); padding: 28rpx 20rpx;
  display: flex; flex-direction: column; align-items: flex-start;
}
.quick__title { font-size: 30rpx; font-weight: 700; color: var(--sr-primary); }
.quick__desc { font-size: 22rpx; color: var(--sr-text-sub); margin-top: 6rpx; }
.quick__soon {
  position: absolute; top: 12rpx; right: 12rpx;
  font-size: 18rpx; color: var(--sr-gold);
  border: 1rpx solid var(--sr-gold-light); border-radius: 6rpx; padding: 0 8rpx;
}

.maps { display: flex; gap: 16rpx; margin-top: 20rpx; }
.mapc { flex: 1; border-radius: var(--sr-radius-sm); overflow: hidden; position: relative; background: var(--sr-bg-sunken); }
.mapc__img { width: 100%; height: 260rpx; display: block; }
.mapc__ph {
  height: 260rpx; display: flex; align-items: center; justify-content: center;
  color: var(--sr-text-weak); font-size: 24rpx;
}
.mapc__label {
  position: absolute; left: 0; right: 0; bottom: 0;
  font-size: 24rpx; color: #fff; text-align: center; padding: 10rpx 0;
  background: linear-gradient(transparent, rgba(0,0,0,0.55));
}

.map-viewer {
  position: fixed; inset: 0; z-index: 200; background: rgba(0,0,0,0.92);
  display: flex; flex-direction: column;
}
.map-viewer__scroll { flex: 1; }
.map-viewer__img { width: 100%; display: block; }
.map-viewer__close {
  position: fixed; top: calc(20rpx + env(safe-area-inset-top)); right: 32rpx;
  color: #fff; font-size: 26rpx; background: rgba(0,0,0,0.5);
  padding: 10rpx 24rpx; border-radius: 32rpx;
}

.act { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--sr-line); }
.act:last-child { border-bottom: none; }
.act__time { flex-shrink: 0; width: 178rpx; font-size: 24rpx; font-weight: 700; color: var(--sr-seal); }
.act__body { flex: 1; display: flex; flex-direction: column; }
.act__name { font-size: 28rpx; color: var(--sr-text); }
.act__note { font-size: 22rpx; color: var(--sr-text-weak); margin-top: 4rpx; }
.empty { text-align: center; color: var(--sr-text-weak); font-size: 26rpx; padding: 32rpx 0; }
.act-note { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx dashed var(--sr-line); font-size: 22rpx; color: var(--sr-text-weak); line-height: 1.6; }
