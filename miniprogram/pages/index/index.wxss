/* ===== 公告横幅（户外强光高对比）===== */
.notice {
  display: flex; align-items: center;
  background: var(--sr-seal);
  border-radius: var(--sr-radius-sm);
  padding: 20rpx 24rpx; margin-bottom: 24rpx;
}
.notice__tag {
  flex-shrink: 0; font-size: 22rpx; font-weight: 700; color: var(--sr-seal);
  background: #fff; border-radius: 8rpx;
  padding: 2rpx 14rpx; margin-right: 16rpx;
}
/* 跑马灯：视口裁剪，双份文字无缝循环 */
.notice__viewport { flex: 1; overflow: hidden; }
.notice__track {
  display: inline-flex; white-space: nowrap;
  animation: notice-marquee 14s linear infinite;
}
.notice__text {
  font-size: 26rpx; color: #fff; font-weight: 500; white-space: nowrap;
  padding-right: 60rpx;
}
@keyframes notice-marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

/* ===== 品牌 Hero + 营业状态 ===== */
.hero {
  position: relative; overflow: hidden;
  background: linear-gradient(135deg, var(--sr-primary) 0%, #173628 100%);
  border-radius: var(--sr-radius-lg);
  padding: 44rpx 40rpx 38rpx; margin-bottom: 28rpx;
  box-shadow: var(--sr-shadow);
}
.hero__glow {
  position: absolute; right: -60rpx; top: -80rpx;
  width: 300rpx; height: 300rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(213, 164, 58, 0.3) 0%, rgba(213, 164, 58, 0) 70%);
}
.hero__title { position: relative; display: block; font-size: 46rpx; font-weight: 800; color: #F7F3EA; letter-spacing: 4rpx; }
.hero__sub { position: relative; display: block; font-size: 24rpx; color: rgba(247, 243, 234, 0.76); margin-top: 12rpx; }
.hero__status {
  position: relative; display: inline-flex; align-items: center; gap: 10rpx;
  margin-top: 24rpx; padding: 10rpx 22rpx; border-radius: 30rpx;
  background: rgba(247, 243, 234, 0.12); font-size: 23rpx; color: rgba(247, 243, 234, 0.8);
}
.hero__status--on { background: rgba(54, 182, 106, 0.18); color: #8FE0AE; }
.hero__status-icon { width: 28rpx; height: 28rpx; filter: brightness(0) invert(1); opacity: 0.85; }


/* ===== 用户状态卡 ===== */
.status-card {
  background: var(--sr-bg-card); border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow); padding: 28rpx 32rpx; margin-bottom: 32rpx;
}
.status-card__head { margin-bottom: 8rpx; }
.status-card__row {
  display: flex; align-items: center;
  padding: 22rpx 0; border-bottom: 1rpx solid var(--sr-line);
}
.status-card__row:last-child { border-bottom: none; padding-bottom: 4rpx; }
.status-card__icon { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.status-card__text { flex: 1; font-size: 27rpx; color: var(--sr-text); margin-left: 18rpx; }
.status-card__num { font-weight: 800; color: var(--sr-seal); }
.status-card__cta { font-size: 24rpx; color: var(--sr-primary); font-weight: 600; }


/* ===== 页脚 ===== */
.foot { padding: 20rpx 0 8rpx; display: flex; flex-direction: column; align-items: center; }
.foot__call {
  display: inline-flex; align-items: center; gap: 12rpx;
  font-size: 26rpx; color: var(--sr-primary); font-weight: 600;
  padding: 16rpx 34rpx; border-radius: 40rpx; background: var(--sr-primary-weak);
}
.foot__icon { width: 32rpx; height: 32rpx; }
.foot__links { display: flex; align-items: center; margin-top: 22rpx; }
.foot__link { font-size: 23rpx; color: var(--sr-text-sub); }
.foot__sep { font-size: 23rpx; color: var(--sr-text-weak); margin: 0 16rpx; }

/* ===== 会员卡黑金主推 ===== */
.promo {
  display: flex; align-items: center; justify-content: space-between;
  border-radius: var(--sr-radius-lg); padding: 36rpx 40rpx; margin-bottom: 32rpx;
  box-shadow: var(--sr-shadow);
}
.promo__left { display: flex; flex-direction: column; }
.promo__badge {
  align-self: flex-start; font-size: 20rpx; font-weight: 700; color: #173628;
  background: var(--sr-gold); border-radius: 8rpx; padding: 2rpx 12rpx;
}
.promo__title { font-size: 36rpx; font-weight: 800; color: var(--sr-gold-light); margin-top: 14rpx; letter-spacing: 2rpx; }
.promo__desc { font-size: 22rpx; color: rgba(247, 243, 234, 0.72); margin-top: 8rpx; }
.promo__right { display: flex; flex-direction: column; align-items: flex-end; }
.promo__price { font-size: 56rpx; font-weight: 800; color: #fff; line-height: 1; }
.promo__cta { font-size: 22rpx; color: var(--sr-gold); margin-top: 12rpx; }

/* ===== 分区标题 ===== */
.sec-title { display: block; font-size: 32rpx; font-weight: 700; color: var(--sr-text); margin: 8rpx 4rpx 20rpx; }
.sec-head { display: flex; align-items: center; }
.sec-head__bar { width: 6rpx; height: 30rpx; border-radius: 4rpx; background: var(--sr-seal); margin-right: 14rpx; }
.sec-head__icon { opacity: 0.8; }

/* ===== 四个快捷入口 ===== */
/* 四列用百分比 + space-between：不依赖 gap，也不混用 % 与 rpx 的 calc（真机会算错） */
.quick { display: flex; justify-content: space-between; margin-bottom: 32rpx; }
.quick__item {
  width: 23.5%; box-sizing: border-box;
  background: var(--sr-bg-card); border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow); padding: 26rpx 8rpx 22rpx;
  display: flex; flex-direction: column; align-items: center;
}
.quick__iconbox {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: var(--sr-primary-weak);
  display: flex; align-items: center; justify-content: center;
}
.quick__icon { width: 46rpx; height: 46rpx; }
.quick__title { font-size: 25rpx; font-weight: 600; color: var(--sr-text); margin-top: 14rpx; }
/* 副标题窄列放不下整句，单行省略即可，详情进子页看 */
.quick__desc {
  font-size: 19rpx; color: var(--sr-text-weak); margin-top: 4rpx;
  max-width: 100%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}




/* ===== 顶部快捷条（状态驱动 · 有票/预约的人一眼看到下一步）===== */
.quickbar {
  display: flex; align-items: center;
  background: linear-gradient(135deg, var(--sr-primary) 0%, var(--sr-primary-deep) 100%);
  border-radius: var(--sr-radius); padding: 24rpx 28rpx; margin-bottom: 24rpx;
  box-shadow: var(--sr-shadow);
}
.quickbar__icon { width: 72rpx; height: 72rpx; border-radius: 50%; background: rgba(255,255,255,0.14);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.quickbar__body { flex: 1; display: flex; flex-direction: column; margin-left: 20rpx; min-width: 0; }
.quickbar__label { font-size: 21rpx; color: var(--sr-gold-light); font-weight: 600; }
.quickbar__text { font-size: 28rpx; color: #F7F3EA; font-weight: 600; margin-top: 4rpx; }
.quickbar__cta { font-size: 24rpx; color: #F7F3EA; font-weight: 700; flex-shrink: 0; }



/* ===== 三大主行动：购票 / 预约 / 补差价升级 =====
   业主反馈「不需要特别标识，靠排版体现轻重缓急」——
   因此只保留一个实心主卡，其余为白底次卡，全页仅一处强调色。 */
.acts { margin-bottom: var(--sr-gap-5); }
.acts__row { display: flex; justify-content: space-between; margin-top: 16rpx; }

.act { border-radius: var(--sr-radius); box-shadow: var(--sr-shadow); }

/* 主卡：品牌绿实心，首屏唯一强调 */
.act--lead {
  display: flex; align-items: center; padding: 34rpx 32rpx;
  background: var(--sr-primary);
}
.act--lead .act__body { flex: 1; margin-left: 22rpx; min-width: 0; }
.act--lead .act__title { font-size: 34rpx; font-weight: 700; color: var(--sr-text-invert); }
.act--lead .act__sub { display: block; font-size: 23rpx; color: rgba(247,243,234,0.78); margin-top: 6rpx; }
.act__iconbox {
  width: 88rpx; height: 88rpx; border-radius: 50%; flex-shrink: 0;
  background: rgba(255,255,255,0.16);
  display: flex; align-items: center; justify-content: center;
}
.act__icon { width: 48rpx; height: 48rpx; filter: brightness(0) invert(1); }

/* 次卡：白底，靠尺寸与位置区分层级，不再另配颜色 */
.act--sub {
  width: 48.5%; box-sizing: border-box; padding: 26rpx 24rpx;
  background: var(--sr-bg-card);
  display: flex; align-items: center;
}
.act__iconbox--sub { width: 64rpx; height: 64rpx; background: var(--sr-primary-weak); }
.act__icon--sub { width: 36rpx; height: 36rpx; filter: none; }
.act--sub .act__body { flex: 1; margin-left: 16rpx; min-width: 0; }
.act__title--sub { display: block; font-size: 27rpx; font-weight: 600; color: var(--sr-text); }
.act__sub--sub {
  display: block; font-size: 19rpx; color: var(--sr-text-weak); margin-top: 4rpx;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
