/* ===== 公告横幅（户外强光高对比）===== */
.notice {
  display: flex; align-items: center;
  background: var(--sr-seal);
  border-radius: var(--sr-radius-sm);
  padding: 20rpx 24rpx; margin-bottom: 24rpx;
}
.notice__tag {
  flex-shrink: 0; font-size: 22rpx; font-weight: 700; color: var(--sr-seal);
  background: #fff; border-radius: 8rpx;
  padding: 2rpx 14rpx; margin-right: 16rpx;
}
/* 跑马灯：视口裁剪，双份文字无缝循环 */
.notice__viewport { flex: 1; overflow: hidden; }
.notice__track {
  display: inline-flex; white-space: nowrap;
  animation: notice-marquee 14s linear infinite;
}
.notice__text {
  font-size: 26rpx; color: #fff; font-weight: 500; white-space: nowrap;
  padding-right: 60rpx;
}
@keyframes notice-marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

/* ===== 品牌 Hero + 营业状态 ===== */
.hero {
  position: relative; overflow: hidden;
  background: linear-gradient(135deg, var(--sr-primary) 0%, #173628 100%);
  border-radius: var(--sr-radius-lg);
  padding: 44rpx 40rpx 38rpx; margin-bottom: 28rpx;
  box-shadow: var(--sr-shadow);
}
.hero__glow {
  position: absolute; right: -60rpx; top: -80rpx;
  width: 300rpx; height: 300rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(213, 164, 58, 0.3) 0%, rgba(213, 164, 58, 0) 70%);
}
.hero__title { position: relative; display: block; font-size: 46rpx; font-weight: 800; color: #F7F3EA; letter-spacing: 4rpx; }
.hero__sub { position: relative; display: block; font-size: 24rpx; color: rgba(247, 243, 234, 0.76); margin-top: 12rpx; }
.hero__status {
  position: relative; display: inline-flex; align-items: center; gap: 10rpx;
  margin-top: 24rpx; padding: 10rpx 22rpx; border-radius: 30rpx;
  background: rgba(247, 243, 234, 0.12); font-size: 23rpx; color: rgba(247, 243, 234, 0.8);
}
.hero__status--on { background: rgba(54, 182, 106, 0.18); color: #8FE0AE; }
.hero__status-icon { width: 28rpx; height: 28rpx; filter: brightness(0) invert(1); opacity: 0.85; }


/* ===== 用户状态卡 ===== */
.status-card {
  background: var(--sr-bg-card); border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow); padding: 28rpx 32rpx; margin-bottom: 32rpx;
}
.status-card__head { margin-bottom: 8rpx; }
.status-card__row {
  display: flex; align-items: center;
  padding: 22rpx 0; border-bottom: 1rpx solid var(--sr-line);
}
.status-card__row:last-child { border-bottom: none; padding-bottom: 4rpx; }
.status-card__icon { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.status-card__text { flex: 1; font-size: 27rpx; color: var(--sr-text); margin-left: 18rpx; }
.status-card__num { font-weight: 800; color: var(--sr-seal); }
.status-card__cta { font-size: 24rpx; color: var(--sr-primary); font-weight: 600; }

/* ===== 特色服务卡（横滑）===== */
.svc-scroll { white-space: nowrap; margin-bottom: 32rpx; }
.svc-card {
  display: inline-flex; flex-direction: column; vertical-align: top;
  width: 240rpx; margin-right: 20rpx;
  background: var(--sr-bg-card); border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow); padding: 28rpx 24rpx 24rpx;
}
.svc-card:last-child { margin-right: 0; }
.svc-card__icon { width: 56rpx; height: 56rpx; }
.svc-card__title { font-size: 28rpx; font-weight: 700; color: var(--sr-text); margin-top: 18rpx; }
.svc-card__sub { font-size: 21rpx; color: var(--sr-text-weak); margin-top: 8rpx; white-space: normal; line-height: 1.5; min-height: 62rpx; }
.svc-card__cta { font-size: 23rpx; color: var(--sr-seal); font-weight: 600; margin-top: 10rpx; }

/* ===== 页脚 ===== */
.foot { padding: 20rpx 0 8rpx; display: flex; flex-direction: column; align-items: center; }
.foot__call {
  display: inline-flex; align-items: center; gap: 12rpx;
  font-size: 26rpx; color: var(--sr-primary); font-weight: 600;
  padding: 16rpx 34rpx; border-radius: 40rpx; background: var(--sr-primary-weak);
}
.foot__icon { width: 32rpx; height: 32rpx; }
.foot__links { display: flex; align-items: center; margin-top: 22rpx; }
.foot__link { font-size: 23rpx; color: var(--sr-text-sub); }
.foot__sep { font-size: 23rpx; color: var(--sr-text-weak); margin: 0 16rpx; }

/* ===== 会员卡黑金主推 ===== */
.promo {
  display: flex; align-items: center; justify-content: space-between;
  border-radius: var(--sr-radius-lg); padding: 36rpx 40rpx; margin-bottom: 32rpx;
  box-shadow: var(--sr-shadow);
}
.promo__left { display: flex; flex-direction: column; }
.promo__badge {
  align-self: flex-start; font-size: 20rpx; font-weight: 700; color: #173628;
  background: var(--sr-gold); border-radius: 8rpx; padding: 2rpx 12rpx;
}
.promo__title { font-size: 36rpx; font-weight: 800; color: var(--sr-gold-light); margin-top: 14rpx; letter-spacing: 2rpx; }
.promo__desc { font-size: 22rpx; color: rgba(247, 243, 234, 0.72); margin-top: 8rpx; }
.promo__right { display: flex; flex-direction: column; align-items: flex-end; }
.promo__price { font-size: 56rpx; font-weight: 800; color: #fff; line-height: 1; }
.promo__cta { font-size: 22rpx; color: var(--sr-gold); margin-top: 12rpx; }

/* ===== 分区标题 ===== */
.sec-title { display: block; font-size: 32rpx; font-weight: 700; color: var(--sr-text); margin: 8rpx 4rpx 20rpx; }
.sec-head { display: flex; align-items: center; }
.sec-head__bar { width: 6rpx; height: 30rpx; border-radius: 4rpx; background: var(--sr-seal); margin-right: 14rpx; }
.sec-head__icon { opacity: 0.8; }

/* ===== 四个快捷入口 ===== */
/* 四列用百分比 + space-between：不依赖 gap，也不混用 % 与 rpx 的 calc（真机会算错） */
.quick { display: flex; justify-content: space-between; margin-bottom: 32rpx; }
.quick__item {
  width: 23.5%; box-sizing: border-box;
  background: var(--sr-bg-card); border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow); padding: 26rpx 8rpx 22rpx;
  display: flex; flex-direction: column; align-items: center;
}
.quick__iconbox {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: var(--sr-primary-weak);
  display: flex; align-items: center; justify-content: center;
}
.quick__icon { width: 46rpx; height: 46rpx; }
.quick__title { font-size: 25rpx; font-weight: 600; color: var(--sr-text); margin-top: 14rpx; }
/* 副标题窄列放不下整句，单行省略即可，详情进子页看 */
.quick__desc {
  font-size: 19rpx; color: var(--sr-text-weak); margin-top: 4rpx;
  max-width: 100%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}

/* ===== 今日江湖事（时间线）===== */
.tl { margin-top: 28rpx; padding-left: 14rpx; border-left: 2rpx solid var(--sr-bg-sunken); }
.tl__item { position: relative; padding: 0 0 36rpx 30rpx; }
.tl__item:last-child { padding-bottom: 8rpx; }
.tl__dot {
  position: absolute; left: -9rpx; top: 10rpx;
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: var(--sr-seal); border: 4rpx solid var(--sr-bg-card);
  box-shadow: 0 0 0 2rpx rgba(240, 112, 85, 0.25);
}
.tl__item:nth-child(n+2) .tl__dot { background: var(--sr-primary-light); box-shadow: 0 0 0 2rpx rgba(58, 103, 73, 0.2); }
.tl__body { display: flex; flex-direction: column; }
.tl__time { font-size: 24rpx; font-weight: 700; color: var(--sr-seal); }
.tl__item:nth-child(n+2) .tl__time { color: var(--sr-primary); }
.tl__name { font-size: 30rpx; font-weight: 600; color: var(--sr-text); margin-top: 6rpx; }
.tl__note { font-size: 22rpx; color: var(--sr-text-weak); margin-top: 4rpx; }

.empty { text-align: center; color: var(--sr-text-weak); font-size: 26rpx; padding: 32rpx 0; }
.act-note { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx dashed var(--sr-line); font-size: 22rpx; color: var(--sr-text-weak); line-height: 1.6; }

/* ===== 园区地图 ===== */
.maps { display: flex; gap: 16rpx; margin-top: 24rpx; }
.mapc { flex: 1; border-radius: var(--sr-radius-sm); overflow: hidden; position: relative; background: var(--sr-bg-sunken); }
.mapc__img { width: 100%; height: 260rpx; display: block; }
.mapc__label {
  position: absolute; left: 0; right: 0; bottom: 0;
  font-size: 24rpx; color: #fff; text-align: center; padding: 10rpx 0;
  background: linear-gradient(transparent, rgba(23, 54, 40, 0.62));
}

.map-viewer { position: fixed; inset: 0; z-index: 200; background: rgba(10, 14, 12, 0.96); }
.mv-area { width: 100vw; height: 100vh; overflow: hidden; }
.mv-view { display: flex; }
.mv-hint {
  position: fixed; bottom: calc(48rpx + env(safe-area-inset-bottom)); left: 0; right: 0;
  text-align: center; color: rgba(255, 255, 255, 0.7); font-size: 22rpx;
}
.map-viewer__close {
  position: fixed; top: calc(24rpx + env(safe-area-inset-top)); right: 32rpx;
  color: #fff; font-size: 26rpx; background: rgba(0, 0, 0, 0.5);
  padding: 12rpx 28rpx; border-radius: 32rpx; z-index: 1;
}

/* ===== 园区导览入口（地图移到园区 Tab 后的首页高可达入口）===== */
.park-entry { position: relative; height: 200rpx; border-radius: var(--sr-radius); overflow: hidden; box-shadow: var(--sr-shadow); }
.park-entry__bg { position: absolute; inset: 0; width: 100%; height: 100%; }
.park-entry__mask { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(23,54,40,0.82) 0%, rgba(23,54,40,0.35) 100%); }
.park-entry__body { position: absolute; left: 32rpx; top: 0; bottom: 0; display: flex; flex-direction: column; justify-content: center; }
.park-entry__title { font-size: 32rpx; font-weight: 700; color: #F7F3EA; }
.park-entry__sub { font-size: 22rpx; color: rgba(247,243,234,0.8); margin-top: 10rpx; }
.park-entry__go { position: absolute; right: 32rpx; bottom: 28rpx; font-size: 24rpx; color: var(--sr-gold-light); font-weight: 600; }

/* ===== 顶部快捷条（状态驱动 · 有票/预约的人一眼看到下一步）===== */
.quickbar {
  display: flex; align-items: center;
  background: linear-gradient(135deg, var(--sr-primary) 0%, var(--sr-primary-deep) 100%);
  border-radius: var(--sr-radius); padding: 24rpx 28rpx; margin-bottom: 24rpx;
  box-shadow: var(--sr-shadow);
}
.quickbar__icon { width: 72rpx; height: 72rpx; border-radius: 50%; background: rgba(255,255,255,0.14);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.quickbar__body { flex: 1; display: flex; flex-direction: column; margin-left: 20rpx; min-width: 0; }
.quickbar__label { font-size: 21rpx; color: var(--sr-gold-light); font-weight: 600; }
.quickbar__text { font-size: 28rpx; color: #F7F3EA; font-weight: 600; margin-top: 4rpx; }
.quickbar__cta { font-size: 24rpx; color: #F7F3EA; font-weight: 700; flex-shrink: 0; }

/* ===== 新客福利卡 ===== */
.newbie {
  position: relative; overflow: hidden;
  background: linear-gradient(135deg, var(--sr-gold) 0%, #C4922E 100%);
  border-radius: var(--sr-radius); padding: 28rpx 32rpx; margin-bottom: 32rpx;
  box-shadow: var(--sr-shadow);
}
.newbie__badge { display: inline-block; font-size: 20rpx; font-weight: 700; color: var(--sr-gold);
  background: #FFF6E4; border-radius: 8rpx; padding: 4rpx 14rpx; margin-bottom: 12rpx; }
.newbie__body { display: flex; align-items: center; justify-content: space-between; }
.newbie__title { flex: 1; font-size: 27rpx; font-weight: 600; color: #4A2F00; line-height: 1.5; margin-right: 16rpx; }
.newbie__cta { font-size: 24rpx; font-weight: 700; color: #4A2F00; flex-shrink: 0; }

/* ===== 三大主行动：购票 / 预约 / 补差价升级 =====
   业主指定的高频核心功能，需一眼可辨。用色语义区分：
     coral  交易（买票）· forest 服务（预约）· gold 增值（升级）
   主卡大、次卡并排，避免三个等大导致没有重点 */
.acts { margin-bottom: var(--sr-gap-5); }
.acts__row { display: flex; justify-content: space-between; margin-top: 20rpx; }

.act { position: relative; overflow: hidden; border-radius: var(--sr-radius); box-shadow: var(--sr-shadow); }
.act__glow { position: absolute; right: -60rpx; top: -80rpx; width: 260rpx; height: 260rpx;
  border-radius: 50%; background: radial-gradient(circle, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0) 70%);
  pointer-events: none; }

/* 主卡：横向大卡 */
.act--lead { display: flex; align-items: center; padding: 36rpx 32rpx; }
.act--lead .act__body { flex: 1; margin-left: 24rpx; min-width: 0; }
.act__iconbox { width: 96rpx; height: 96rpx; border-radius: 50%; background: rgba(255,255,255,0.18);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.act__icon { width: 52rpx; height: 52rpx; filter: brightness(0) invert(1); }
.act__titlerow { display: flex; align-items: center; }
.act__title { font-size: 34rpx; font-weight: 700; color: #F7F3EA; }
.act__badge { font-size: 19rpx; font-weight: 700; color: rgba(255,255,255,0.92);
  background: rgba(255,255,255,0.22); padding: 4rpx 14rpx; border-radius: 8rpx; margin-left: 14rpx; }
.act__sub { display: block; font-size: 23rpx; color: rgba(247,243,234,0.82); margin-top: 8rpx; }

/* 次卡：两个并排，竖排内容 */
.act--sub { width: 48.5%; box-sizing: border-box; padding: 30rpx 26rpx 28rpx;
  display: flex; flex-direction: column; align-items: flex-start; }
.act__iconbox--sm { width: 76rpx; height: 76rpx; }
.act__iconbox--sm .act__icon { width: 42rpx; height: 42rpx; }
.act__title--sm { font-size: 30rpx; margin-top: 18rpx; }
.act__sub--sm { font-size: 20rpx; margin-top: 6rpx; line-height: 1.4;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

/* 三种配色语义 */
.act--coral { background: linear-gradient(135deg, #F07055 0%, #D8543A 100%); }
.act--forest { background: linear-gradient(135deg, var(--sr-primary) 0%, var(--sr-primary-deep) 100%); }
.act--gold { background: linear-gradient(135deg, #D5A43A 0%, #B8862A 100%); }
