<view class="sr-page sr-page--tab sr-enter">
  <!-- 1. 公告（有才显示 · 户外强光高对比 · 跑马灯避免截断） -->
  <view class="notice" wx:if="{{notice}}">
    <view class="notice__tag">公告</view>
    <view class="notice__viewport">
      <view class="notice__track">
        <text class="notice__text">{{notice}}</text>
        <text class="notice__text notice__text--dup">{{notice}}</text>
      </view>
    </view>
  </view>

  <!-- 2. 品牌 Hero + 今日营业状态 -->
  <view class="hero" wx:if="{{hero}}">
    <view class="hero__glow"></view>
    <text class="hero__title">{{hero.title}}</text>
    <text class="hero__sub">{{hero.subtitle}}</text>
    <view class="hero__status {{openStatus.open ? 'hero__status--on' : ''}}">
      <image class="hero__status-icon" src="/assets/icons/forest/home-open-status.png" mode="aspectFit" />
      <text>{{openStatus.text}}</text>
    </view>
  </view>

  <!-- 3. 顶部快捷条（状态驱动）：有票→入园码，有预约→预约详情。无则不占位 -->
  <view class="quickbar sr-touch" wx:if="{{quickBar}}" hover-class="sr-touch--press" hover-stay-time="60" bindtap="onQuickBar">
    <view class="quickbar__icon">
      <sr-icon name="{{quickBar.type === 'ticket' ? 'home-ticket' : 'home-reservation'}}" theme="light" size="md" invert />
    </view>
    <view class="quickbar__body">
      <text class="quickbar__label">{{quickBar.type === 'ticket' ? '待入园' : '待到访'}}</text>
      <text class="quickbar__text">{{quickBar.text}}</text>
    </view>
    <text class="quickbar__cta">{{quickBar.cta}} ›</text>
  </view>

  <!-- 4. 三大主行动：购票 / 预约 / 补差价升级
       结构统一的纵向列表，主次只靠「实心 vs 白底」区分——
       尺寸差异过大会让次要项显得可有可无，也会因数量变化留出空位 -->
  <view class="acts" wx:if="{{primaryActions.length}}">
    <view wx:for="{{primaryActions}}" wx:key="key"
          class="act {{item.level === 'primary' ? 'act--lead' : 'act--sub'}} sr-touch"
          hover-class="{{item.level === 'primary' ? 'sr-touch--cta' : 'sr-touch--press'}}" hover-stay-time="60"
          data-key="{{item.key}}" bindtap="onSectionTap">
      <view class="act__iconbox">
        <image class="act__icon" src="{{item.icon}}" mode="aspectFit" />
      </view>
      <view class="act__body">
        <text class="act__title">{{item.title}}</text>
        <text class="act__sub">{{item.subtitle}}</text>
      </view>
      <sr-icon name="nav-forward" theme="light" size="sm" invert="{{item.level === 'primary'}}" />
    </view>
  </view>

  <!-- 5. 会员卡（非会员可见 · 新客福利文案已并入，不再单独一张卡） -->
  <view class="promo sr-goldcard sr-gold-hairline sr-touch" wx:if="{{showMemberPromo}}"
        hover-class="sr-touch--card" hover-stay-time="60" data-key="{{memberSection.key}}" bindtap="onSectionTap">
    <view class="promo__left">
      <text class="promo__badge">{{homeStage === 'first' ? '新客专享' : 'SVIP'}}</text>
      <text class="promo__title">森水会员卡</text>
      <text class="promo__desc">1000 长河令 · 生日 85 折 · 一年畅玩</text>
    </view>
    <view class="promo__right">
      <text class="promo__price sr-num">¥9.9</text>
      <text class="promo__cta">立即开卡 ›</text>
    </view>
  </view>

  <!-- 6. 了解园区（四个入口 · 含特色服务咨询） -->
  <view class="quick" wx:if="{{quickEntries.length}}">
    <view class="quick__item sr-touch" hover-class="sr-touch--press" hover-stay-time="60"
          wx:for="{{quickEntries}}" wx:key="key" data-key="{{item.key}}" bindtap="onSectionTap">
      <view class="quick__iconbox">
        <image class="quick__icon" src="{{item.icon}}" mode="aspectFit" />
      </view>
      <text class="quick__title">{{item.title}}</text>
      <text class="quick__desc">{{item.subtitle}}</text>
    </view>
  </view>

  <!-- 7. 页脚：客服与协议 -->
  <view class="foot" wx:if="{{footerSection}}">
    <view class="foot__call sr-touch" hover-class="sr-touch--press" hover-stay-time="60" bindtap="callFront">
      <image class="foot__icon" src="/assets/icons/forest/customer-service.png" mode="aspectFit" />
      <text>联系前台 · <text class="sr-num">{{frontPhone}}</text></text>
    </view>
    <view class="foot__links">
      <text class="foot__link" bindtap="goAgreement">用户服务协议</text>
      <text class="foot__sep">·</text>
      <text class="foot__link" bindtap="goPrivacy">隐私政策</text>
    </view>
  </view>
</view>
