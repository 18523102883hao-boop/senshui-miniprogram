<view class="sr-page sr-page--tab sr-enter">
  <!-- 1. 公告横幅（高对比 · 户外强光可读 · 跑马灯避免截断） -->
  <view class="notice" wx:if="{{notice}}">
    <view class="notice__tag">公告</view>
    <view class="notice__viewport">
      <view class="notice__track">
        <text class="notice__text">{{notice}}</text>
        <text class="notice__text notice__text--dup">{{notice}}</text>
      </view>
    </view>
  </view>

  <!-- 2. 品牌 Hero + 营业状态 -->
  <view class="hero" wx:if="{{hero}}">
    <view class="hero__glow"></view>
    <text class="hero__title">{{hero.title}}</text>
    <text class="hero__sub">{{hero.subtitle}}</text>
    <view class="hero__status {{openStatus.open ? 'hero__status--on' : ''}}">
      <image class="hero__status-icon" src="/assets/icons/forest/home-open-status.png" mode="aspectFit" />
      <text>{{openStatus.text}}</text>
    </view>
  </view>

  <!-- 3. 四个次级快捷入口 -->
  <view class="quick" wx:if="{{quickEntries.length}}">
    <view class="quick__item sr-touch" hover-class="sr-touch--press" hover-stay-time="60"
          wx:for="{{quickEntries}}" wx:key="key" data-key="{{item.key}}" bindtap="onSectionTap">
      <view class="quick__iconbox">
        <image class="quick__icon" src="{{item.icon}}" mode="aspectFit" />
      </view>
      <text class="quick__title">{{item.title}}</text>
      <text class="quick__desc">{{item.subtitle}}</text>
    </view>
  </view>

  <!-- 4. 两个主转化卡：购票 / 预约 -->
  <view class="primary" wx:if="{{primaryActions.length}}">
    <view class="primary__card sr-touch" hover-class="sr-touch--cta" hover-stay-time="60"
          wx:for="{{primaryActions}}" wx:key="key" data-key="{{item.key}}" bindtap="onSectionTap">
      <image class="primary__icon" src="{{item.icon}}" mode="aspectFit" />
      <view class="primary__body">
        <text class="primary__title">{{item.title}}</text>
        <text class="primary__sub">{{item.subtitle}}</text>
      </view>
      <text class="primary__arrow">›</text>
    </view>
  </view>

  <!-- 5. 当前用户状态卡（无票无预约时不占位） -->
  <view class="status-card" wx:if="{{showUserStatus}}">
    <view class="sec-head status-card__head">
      <view class="sec-head__bar"></view>
      <text class="sr-subtitle">我的行程</text>
    </view>
    <view class="status-card__row sr-touch" wx:if="{{userSummary.unusedTicketCount > 0}}"
          hover-class="sr-touch--press" hover-stay-time="60" bindtap="goMyTickets">
      <image class="status-card__icon" src="/assets/icons/forest/home-ticket.png" mode="aspectFit" />
      <text class="status-card__text">你有 <text class="sr-num status-card__num">{{userSummary.unusedTicketCount}}</text> 张未使用门票</text>
      <text class="status-card__cta">查看入园码 ›</text>
    </view>
    <view class="status-card__row sr-touch" wx:if="{{userSummary.upcomingReservation}}"
          hover-class="sr-touch--press" hover-stay-time="60" bindtap="goMyReservation">
      <image class="status-card__icon" src="/assets/icons/forest/home-reservation.png" mode="aspectFit" />
      <text class="status-card__text">
        <text class="sr-num">{{userSummary.upcomingReservation.visitDate}}</text>
        <text wx:if="{{userSummary.upcomingReservation.timeSlot}}"> {{userSummary.upcomingReservation.timeSlot}}</text>
        · <text class="sr-num">{{userSummary.upcomingReservation.partySize}}</text> 人
      </text>
      <text class="status-card__cta">查看预约 ›</text>
    </view>
  </view>

  <!-- 6. 三个特色服务卡 -->
  <block wx:if="{{serviceCards.length}}">
    <text class="sec-title">特色服务</text>
    <scroll-view class="svc-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="svc-card sr-touch" hover-class="sr-touch--press" hover-stay-time="60"
            wx:for="{{serviceCards}}" wx:key="key" data-key="{{item.key}}" bindtap="onSectionTap">
        <image class="svc-card__icon" src="{{item.icon}}" mode="aspectFit" />
        <text class="svc-card__title">{{item.title}}</text>
        <text class="svc-card__sub">{{item.subtitle}}</text>
        <text class="svc-card__cta">咨询 ›</text>
      </view>
    </scroll-view>
  </block>

  <!-- 7. 会员卡（黑金主推 · 整卡可点） -->
  <view class="promo sr-goldcard sr-gold-hairline sr-touch" wx:if="{{memberSection}}"
        hover-class="sr-touch--press" hover-stay-time="60" data-key="{{memberSection.key}}" bindtap="onSectionTap">
    <view class="promo__left">
      <text class="promo__badge">SVIP</text>
      <text class="promo__title">森水会员卡</text>
      <text class="promo__desc">1000 长河令 · 生日 85 折 · 一年畅玩</text>
    </view>
    <view class="promo__right">
      <text class="promo__price sr-num">¥9.9</text>
      <text class="promo__cta">立即开卡 ›</text>
    </view>
  </view>

  <!-- 8. 今日江湖事（时间线） -->
  <view class="sr-card" wx:if="{{showActivities}}">
    <view class="sr-row-between">
      <view class="sec-head">
        <view class="sec-head__bar"></view>
        <text class="sr-subtitle">今日江湖事</text>
      </view>
      <image class="sr-icon--sm sec-head__icon" src="/assets/icons/forest/activity-schedule.png" mode="aspectFit" />
    </view>
    <view class="tl">
      <view class="tl__item" wx:for="{{activities}}" wx:key="id">
        <view class="tl__dot"></view>
        <view class="tl__body">
          <text class="tl__time sr-num">{{item.time}}</text>
          <text class="tl__name">{{item.name}}</text>
          <text class="tl__note">{{item.note}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{!activities.length}}" class="empty">今日暂无活动安排</view>
    <view class="act-note">活动会根据季节、主题和实际情况调整，具体以现场通知为准。</view>
  </view>

  <!-- 9. 园区地图 -->
  <view class="sr-card" wx:if="{{showMap}}">
    <view class="sr-row-between">
      <view class="sec-head">
        <view class="sec-head__bar"></view>
        <text class="sr-subtitle">园区地图</text>
      </view>
      <text class="sr-text-weak">点击查看大图</text>
    </view>
    <view class="maps">
      <view class="mapc sr-touch" hover-class="sr-touch--press" hover-stay-time="60" data-key="camp" bindtap="openMap">
        <image src="{{campMapUrl || '/images/map-camp.jpg'}}" mode="aspectFill" class="mapc__img" />
        <text class="mapc__label">营地游览图</text>
      </view>
      <view class="mapc sr-touch" hover-class="sr-touch--press" hover-stay-time="60" data-key="creek" bindtap="openMap">
        <image src="{{creekMapUrl || '/images/map-creek.jpg'}}" mode="aspectFill" class="mapc__img" />
        <text class="mapc__label">溪降游览图</text>
      </view>
    </view>
  </view>

  <!-- 10. 页脚：客服与协议 -->
  <view class="foot" wx:if="{{footerSection}}">
    <view class="foot__call sr-touch" hover-class="sr-touch--press" hover-stay-time="60" bindtap="callFront">
      <image class="foot__icon" src="/assets/icons/forest/customer-service.png" mode="aspectFit" />
      <text>联系前台 · <text class="sr-num">{{frontPhone}}</text></text>
    </view>
    <view class="foot__links">
      <text class="foot__link" bindtap="goAgreement">用户服务协议</text>
      <text class="foot__sep">·</text>
      <text class="foot__link" bindtap="goPrivacy">隐私政策</text>
    </view>
  </view>

  <!-- 全屏地图查看（双指缩放 + 拖动） -->
  <view class="map-viewer" wx:if="{{mapViewer}}">
    <movable-area class="mv-area" scale-area>
      <movable-view class="mv-view" direction="all" scale scale-min="1" scale-max="4" scale-value="1"
                    style="width:{{mapViewW}}px;height:{{mapViewH}}px;">
        <image src="{{mapViewer}}" style="width:{{mapViewW}}px;height:{{mapViewH}}px;" mode="scaleToFill" />
      </movable-view>
    </movable-area>
    <view class="mv-hint">双指缩放查看 · 拖动移动</view>
    <view class="map-viewer__close" bindtap="closeMapViewer">✕ 关闭</view>
  </view>
</view>
