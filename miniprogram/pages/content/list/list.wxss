/* 内容中心 · 列表 */
.cats { white-space: nowrap; margin-bottom: 24rpx; }
.cat {
  display: inline-block; vertical-align: top;
  padding: 14rpx 30rpx; margin-right: 16rpx;
  font-size: 26rpx; color: var(--sr-text-sub);
  background: var(--sr-bg-card); border-radius: 32rpx;
  box-shadow: var(--sr-shadow);
}
.cat--on { background: var(--sr-primary); color: #fff; font-weight: 600; }

.cache-tip {
  font-size: 22rpx; color: var(--sr-gold);
  background: rgba(213, 164, 58, 0.12);
  padding: 14rpx 24rpx; border-radius: var(--sr-radius-sm); margin-bottom: 20rpx;
}

/* 骨架屏：避免首屏白闪 */
.skeleton__item {
  height: 180rpx; border-radius: var(--sr-radius);
  background: var(--sr-bg-sunken); margin-bottom: 20rpx;
  opacity: 0.6;
}

.list { display: flex; flex-direction: column; }
.item {
  display: flex; align-items: center;
  background: var(--sr-bg-card); border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow); padding: 24rpx; margin-bottom: 20rpx;
}
.item__cover { width: 180rpx; height: 132rpx; border-radius: var(--sr-radius-sm); flex-shrink: 0; background: var(--sr-bg-sunken); }
.item__body { flex: 1; display: flex; flex-direction: column; margin-left: 24rpx; min-width: 0; }
.item__title { font-size: 30rpx; font-weight: 600; color: var(--sr-text); }
.item__summary {
  font-size: 23rpx; color: var(--sr-text-sub); margin-top: 10rpx; line-height: 1.5;
  overflow: hidden; text-overflow: ellipsis; display: -webkit-box;
  -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.item__arrow { width: 28rpx; height: 28rpx; opacity: 0.35; flex-shrink: 0; margin-left: 12rpx; }

.state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.state__icon { width: 96rpx; height: 96rpx; opacity: 0.5; }
.state__text { font-size: 28rpx; color: var(--sr-text); margin-top: 24rpx; font-weight: 600; }
.state__sub { font-size: 23rpx; color: var(--sr-text-weak); margin-top: 10rpx; }
.state__btn {
  margin-top: 32rpx; padding: 18rpx 56rpx; border-radius: 40rpx;
  background: var(--sr-primary); color: #fff; font-size: 26rpx; font-weight: 600;
}

.more { text-align: center; font-size: 23rpx; color: var(--sr-text-weak); padding: 32rpx 0 16rpx; }
