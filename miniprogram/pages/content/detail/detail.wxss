/* 内容中心 · 详情（结构化区块） */
.cache-tip {
  font-size: 22rpx; color: var(--sr-gold);
  background: rgba(213, 164, 58, 0.12);
  padding: 14rpx 24rpx; border-radius: var(--sr-radius-sm); margin-bottom: 20rpx;
}

/* hero */
.b-hero {
  position: relative; overflow: hidden;
  background: linear-gradient(135deg, var(--sr-primary) 0%, #173628 100%);
  border-radius: var(--sr-radius-lg); padding: 44rpx 40rpx; margin-bottom: 28rpx;
}
.b-hero__glow {
  position: absolute; right: -60rpx; top: -80rpx; width: 300rpx; height: 300rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(213, 164, 58, 0.28) 0%, rgba(213, 164, 58, 0) 70%);
}
.b-hero__title { position: relative; display: block; font-size: 42rpx; font-weight: 800; color: #F7F3EA; letter-spacing: 2rpx; }
.b-hero__sub { position: relative; display: block; font-size: 24rpx; color: rgba(247, 243, 234, 0.76); margin-top: 12rpx; }

/* text */
.b-text { display: block; font-size: 28rpx; color: var(--sr-text); line-height: 1.8; margin-bottom: 28rpx; }

/* image / gallery */
.b-image { margin-bottom: 28rpx; }
.b-image__img { width: 100%; border-radius: var(--sr-radius); display: block; background: var(--sr-bg-sunken); }
.b-image__cap { display: block; font-size: 22rpx; color: var(--sr-text-weak); text-align: center; margin-top: 12rpx; }
.b-gallery { display: flex; flex-wrap: wrap; justify-content: space-between; margin-bottom: 28rpx; }
.b-gallery__img { width: 48.5%; height: 240rpx; border-radius: var(--sr-radius-sm); margin-bottom: 16rpx; background: var(--sr-bg-sunken); }

/* list */
.b-list { margin-bottom: 28rpx; }
.b-list__title { display: block; font-size: 30rpx; font-weight: 700; color: var(--sr-text); margin-bottom: 20rpx; }
.b-list__item { display: flex; align-items: flex-start; padding: 12rpx 0; }
.b-list__dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--sr-seal); margin: 14rpx 18rpx 0 0; flex-shrink: 0; }
.b-list__text { flex: 1; font-size: 27rpx; color: var(--sr-text-sub); line-height: 1.7; }

/* notice */
.b-notice {
  display: flex; align-items: flex-start;
  background: rgba(240, 112, 85, 0.1); border-left: 6rpx solid var(--sr-seal);
  border-radius: var(--sr-radius-sm); padding: 24rpx 26rpx; margin-bottom: 28rpx;
}
.b-notice__icon { width: 36rpx; height: 36rpx; flex-shrink: 0; margin-top: 2rpx; }
.b-notice__text { flex: 1; font-size: 25rpx; color: var(--sr-text); line-height: 1.7; margin-left: 18rpx; }

/* feature_grid：两列百分比布局，不用 gap/calc（真机兼容） */
.b-grid { display: flex; flex-wrap: wrap; justify-content: space-between; margin-bottom: 28rpx; }
.b-grid__cell {
  width: 48.5%; box-sizing: border-box;
  background: var(--sr-bg-card); border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow); padding: 28rpx 24rpx; margin-bottom: 20rpx;
}
.b-grid__title { display: block; font-size: 28rpx; font-weight: 700; color: var(--sr-text); }
.b-grid__desc { display: block; font-size: 22rpx; color: var(--sr-text-weak); margin-top: 10rpx; line-height: 1.6; }

/* service_list */
.b-svc { margin-bottom: 28rpx; }
.b-svc__row { padding: 22rpx 0; border-bottom: 1rpx solid var(--sr-line); }
.b-svc__row:last-child { border-bottom: none; padding-bottom: 4rpx; }
.b-svc__title { display: block; font-size: 28rpx; font-weight: 600; color: var(--sr-text); }
.b-svc__desc { display: block; font-size: 23rpx; color: var(--sr-text-sub); margin-top: 8rpx; line-height: 1.6; }

/* timeline */
.b-tl { margin-bottom: 28rpx; }
.b-tl__item { position: relative; padding: 0 0 32rpx 30rpx; border-left: 2rpx solid var(--sr-bg-sunken); margin-left: 10rpx; }
.b-tl__item:last-child { padding-bottom: 4rpx; border-left-color: transparent; }
.b-tl__dot {
  position: absolute; left: -9rpx; top: 8rpx; width: 16rpx; height: 16rpx; border-radius: 50%;
  background: var(--sr-primary-light); border: 4rpx solid var(--sr-bg-card);
}
.b-tl__time { display: block; font-size: 23rpx; font-weight: 700; color: var(--sr-seal); }
.b-tl__title { display: block; font-size: 28rpx; font-weight: 600; color: var(--sr-text); margin-top: 6rpx; }
.b-tl__desc { display: block; font-size: 22rpx; color: var(--sr-text-weak); margin-top: 4rpx; }

/* faq */
.b-faq { margin-bottom: 28rpx; }
.b-faq__item { padding: 22rpx 0; border-bottom: 1rpx solid var(--sr-line); }
.b-faq__item:last-child { border-bottom: none; padding-bottom: 4rpx; }
.b-faq__q { display: block; font-size: 27rpx; font-weight: 700; color: var(--sr-text); }
.b-faq__a { display: block; font-size: 24rpx; color: var(--sr-text-sub); margin-top: 10rpx; line-height: 1.7; }

/* cta */
.b-cta {
  display: flex; align-items: center; justify-content: center;
  background: var(--sr-primary); color: #fff;
  font-size: 30rpx; font-weight: 700;
  border-radius: var(--sr-radius); padding: 30rpx; margin-bottom: 28rpx;
  box-shadow: var(--sr-shadow);
}
.b-cta__arrow { font-size: 36rpx; margin-left: 10rpx; }

.tail { font-size: 21rpx; color: var(--sr-text-weak); text-align: center; padding: 16rpx 0 40rpx; line-height: 1.6; }


/* 常驻底部导航避让 */
.sr-page { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)) !important; }
