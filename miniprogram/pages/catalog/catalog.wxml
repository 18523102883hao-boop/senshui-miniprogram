<view class="sr-page sr-enter">
  <!-- 分类（横滑选择 · 吸附选中态） -->
  <scroll-view scroll-x enable-flick class="tabs-scroll" wx:if="{{sections.length}}">
    <view class="tabs">
      <view wx:for="{{sections}}" wx:key="key"
            class="tab sr-touch {{activeKey === item.key ? 'tab--on' : ''}}"
            hover-class="sr-touch--card" hover-stay-time="60"
            data-key="{{item.key}}" bindtap="switchTab">
        <image class="tab__icon" src="{{item.iconPath}}" mode="aspectFit" />
        <text class="tab__text">{{item.title}}</text>
      </view>
    </view>
  </scroll-view>

  <block wx:for="{{sections}}" wx:key="key">
    <view wx:if="{{activeKey === item.key}}">
      <!-- 价目分组 -->
      <view wx:for="{{item.groups}}" wx:for-item="g" wx:key="name" class="sr-card">
        <view class="grp-head">
          <view class="grp-head__bar"></view>
          <text class="grp-head__title">{{g.name}}</text>
        </view>
        <view wx:for="{{g.items}}" wx:for-item="it" wx:key="n" class="row">
          <text class="row__n">{{it.n}}</text>
          <text class="row__p sr-num">¥{{it.p}}<text class="row__u" wx:if="{{g.unit}}"> /{{g.unit}}</text></text>
        </view>
      </view>

      <!-- 租赁（租金 / 押金）-->
      <view wx:if="{{item.rentals}}" class="sr-card">
        <view class="grp-head">
          <view class="grp-head__bar"></view>
          <text class="grp-head__title">装备租赁</text>
        </view>
        <view wx:for="{{item.rentals}}" wx:for-item="r" wx:key="n" class="row">
          <text class="row__n">{{r.n}}</text>
          <view class="rent">
            <text class="chip chip--rent sr-num">租 ¥{{r.rent}}</text>
            <text class="chip chip--dep sr-num">押 ¥{{r.deposit}}</text>
          </view>
        </view>
        <text class="tip">押金在归还且设备完好后全额退还。</text>
      </view>

      <!-- 服务 -->
      <view wx:if="{{item.services}}">
        <view wx:for="{{item.services}}" wx:for-item="s" wx:key="n" class="sr-card svc">
          <view class="svc__head">
            <image class="svc__icon" src="/assets/icons/forest/shop-rental.png" mode="aspectFit" />
            <text class="svc__n">{{s.n}}</text>
            <view class="svc__badge sr-num">押金 ¥{{s.deposit}}/台</view>
          </view>
          <text class="svc__desc">{{s.desc}}</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 下单与咨询：看完价目直接找工作人员（酒水可送到营位） -->
  <block wx:if="{{!loading && !hasError && sections.length}}">
    <sr-section-header title="下单与咨询" />
    <sr-contact-card scene="concierge"
                     title="加管家微信下单"
                     desc="酒水与小卖部商品可送到营位，租赁按现场库存安排" />
  </block>

  <sr-skeleton wx:if="{{loading}}" type="card" rows="3" />

  <sr-empty-state wx:if="{{isEmpty && !loading && !hasError}}"
                  icon="home-store" title="目录整备中"
                  desc="酒水、小卖部与租赁价目稍后上线，可先咨询管家" />

  <sr-error-state wx:if="{{hasError && !loading}}" bind:retry="onRetry" />

  <!-- 常驻底部导航：二级页面也能直接切 Tab -->
  <sr-tabbar theme="light" />
</view>
