.tip { display: block; font-size: 24rpx; color: var(--sr-text-sub); line-height: 1.9; }

.card {
  background: linear-gradient(135deg, #244B36, #173628);
  border-radius: var(--sr-radius); padding: 40rpx; margin-bottom: 24rpx;
  display: flex; flex-direction: column; align-items: center;
}
.card__title { font-size: 30rpx; font-weight: 700; color: #E0B95C; align-self: flex-start; }
.card__balance { display: flex; align-items: baseline; margin: 8rpx 0 24rpx; align-self: flex-start; color: #fff; }
.card__num { font-size: 64rpx; font-weight: 800; }
.card__unit { font-size: 26rpx; color: rgba(255,255,255,0.7); }

.card__qr { width: 100%; background: #fff; border-radius: var(--sr-radius-sm); padding: 40rpx; display: flex; flex-direction: column; align-items: center; }
.card__qr-box {
  width: 320rpx; height: 320rpx; border-radius: 12rpx; background: var(--sr-bg-sunken);
  color: var(--sr-text-weak); display: flex; align-items: center; justify-content: center; font-size: 28rpx;
}
.card__qr-canvas { width: 320rpx; height: 320rpx; }
.card__qr-tip { font-size: 24rpx; color: var(--sr-text); font-weight: 600; margin-top: 20rpx; }
.card__qr-sub { font-size: 22rpx; color: var(--sr-text-weak); margin-top: 6rpx; }
