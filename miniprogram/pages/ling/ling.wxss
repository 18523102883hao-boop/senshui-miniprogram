.ling-banner {
  display: flex; align-items: center; justify-content: space-between;
  background: linear-gradient(135deg, var(--sr-primary), var(--sr-primary-light));
  border-radius: var(--sr-radius); padding: 36rpx 40rpx; margin-bottom: 24rpx;
}
.ling-banner__label { font-size: 24rpx; color: rgba(255,255,255,0.8); }
.ling-banner__num { font-size: 64rpx; font-weight: 800; color: #fff; line-height: 1.2; }
.ling-banner__seal {
  width: 96rpx; height: 96rpx; border-radius: 12rpx;
  background: var(--sr-seal); color: #fff; font-size: 48rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  transform: rotate(-6deg);
}

.story { font-size: 27rpx; color: var(--sr-text-sub); line-height: 1.8; }

.earn { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid var(--sr-line); }
.earn:last-child { border-bottom: none; }
.earn__main { display: flex; flex-direction: column; }
.earn__name { font-size: 28rpx; color: var(--sr-text); }
.earn__meta { font-size: 22rpx; color: var(--sr-text-weak); margin-top: 4rpx; }
.earn__ling { display: flex; flex-direction: column; align-items: flex-end; }
.earn__reward { font-size: 26rpx; color: var(--sr-gold); font-weight: 600; }
.earn__join { font-size: 22rpx; color: var(--sr-text-weak); margin-top: 4rpx; }

.exchange { display: flex; flex-wrap: wrap; gap: 16rpx; }
.exchange__item {
  width: calc(50% - 8rpx); box-sizing: border-box;
  background: var(--sr-bg-sunken); border-radius: var(--sr-radius-sm);
  padding: 20rpx; display: flex; flex-direction: column;
}
.exchange__name { font-size: 26rpx; color: var(--sr-text); }
.exchange__cost { font-size: 24rpx; color: var(--sr-seal); margin-top: 8rpx; font-weight: 600; }
.tip { display: block; margin-top: 16rpx; font-size: 22rpx; color: var(--sr-text-weak); }

.npc { display: flex; align-items: center; gap: 16rpx; padding: 8rpx 0; }
.npc__name { font-size: 26rpx; color: var(--sr-text); }
.npc__time { font-size: 24rpx; color: var(--sr-seal); }
.npc__route { font-size: 22rpx; color: var(--sr-text-weak); }
