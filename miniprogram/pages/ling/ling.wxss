/* 长河令 · 深色沉浸主题（#121212）*/
page { background: var(--sr-dark-bg); }
.dk-page { min-height: 100vh; padding: 24rpx 32rpx calc(160rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

/* ===== 资产卡（弥散光）===== */
.asset { padding: 44rpx 40rpx; margin-bottom: 40rpx; }
.asset__head { display: flex; align-items: center; justify-content: space-between; }
.asset__label { font-size: 26rpx; color: var(--sr-dark-muted); letter-spacing: 2rpx; }
.asset__icon { width: 48rpx; height: 48rpx; opacity: 0.85; }
.asset__balance { display: flex; align-items: baseline; margin-top: 16rpx; }
.asset__num {
  font-size: 88rpx; font-weight: 900; color: var(--sr-gold);
  line-height: 1.1; letter-spacing: -2rpx;
}
.asset__unit { font-size: 28rpx; color: var(--sr-dark-muted); margin-left: 14rpx; }
.asset__actions { margin-top: 36rpx; }
.asset__cta {
  display: flex; align-items: center; justify-content: center; gap: 14rpx;
  height: 92rpx; border-radius: 46rpx;
  background: var(--sr-seal); color: #fff;
  font-size: 30rpx; font-weight: 700;
}
.asset__cta-icon { width: 40rpx; height: 40rpx; }

/* ===== 区块标题 ===== */
.dk-sec { display: flex; align-items: baseline; justify-content: space-between; margin: 8rpx 4rpx 20rpx; }
.dk-sec__title { display: block; font-size: 34rpx; font-weight: 700; color: var(--sr-text-invert); }
.dk-sec__sub { font-size: 22rpx; color: var(--sr-dark-muted); }

/* ===== 悬赏榜（整行可点）===== */
.hunt {
  display: flex; align-items: center; gap: 22rpx;
  background: var(--sr-dark-card); border-radius: var(--sr-radius);
  padding: 28rpx; margin-bottom: 18rpx;
}
.hunt__iconbox {
  width: 76rpx; height: 76rpx; border-radius: 50%; flex-shrink: 0;
  background: rgba(213, 164, 58, 0.10);
  display: flex; align-items: center; justify-content: center;
}
.hunt__icon { width: 42rpx; height: 42rpx; }
.hunt__body { flex: 1; display: flex; flex-direction: column; }
.hunt__name { font-size: 29rpx; font-weight: 600; color: var(--sr-text-invert); }
.hunt__meta { font-size: 22rpx; color: var(--sr-dark-muted); margin-top: 6rpx; }
.hunt__right { display: flex; flex-direction: column; align-items: flex-end; }
.hunt__reward {
  font-size: 23rpx; font-weight: 700; color: var(--sr-gold);
  background: rgba(213, 164, 58, 0.12); border: 1rpx solid rgba(213, 164, 58, 0.28);
  padding: 6rpx 18rpx; border-radius: 26rpx;
}
.hunt__join { font-size: 20rpx; color: var(--sr-dark-muted); margin-top: 8rpx; }

/* ===== 兑换 ===== */
.ex-grid { display: flex; flex-wrap: wrap; gap: 18rpx; }
.ex {
  width: calc(50% - 9rpx); box-sizing: border-box;
  background: var(--sr-dark-card); border-radius: var(--sr-radius);
  padding: 28rpx; display: flex; flex-direction: column; align-items: flex-start;
}
.ex__icon { width: 44rpx; height: 44rpx; opacity: 0.9; }
.ex__name { font-size: 26rpx; color: var(--sr-text-invert); margin-top: 16rpx; }
.ex__cost { font-size: 26rpx; color: var(--sr-gold); margin-top: 8rpx; font-weight: 700; }
.dk-tip { display: block; margin: 20rpx 4rpx 36rpx; font-size: 22rpx; color: var(--sr-dark-muted); }

/* ===== 故事 / NPC ===== */
.story { display: block; font-size: 26rpx; color: var(--sr-dark-muted); line-height: 1.9; margin-top: 18rpx; }
.npc { display: flex; align-items: center; gap: 18rpx; margin-top: 20rpx; }
.npc__icon { width: 40rpx; height: 40rpx; opacity: 0.85; flex-shrink: 0; }
.npc__body { display: flex; flex-direction: column; }
.npc__name { font-size: 27rpx; color: var(--sr-text-invert); }
.npc__meta { font-size: 22rpx; color: var(--sr-dark-muted); margin-top: 4rpx; }

/* ===== 长按预览层 ===== */
.pv {
  position: fixed; inset: 0; z-index: 300;
  background: rgba(0, 0, 0, 0.72);
  display: flex; align-items: center; justify-content: center;
}
.pv__card {
  width: 540rpx; padding: 56rpx 40rpx;
  display: flex; flex-direction: column; align-items: center;
}
.pv__icon { width: 96rpx; height: 96rpx; }
.pv__name { font-size: 32rpx; font-weight: 700; color: var(--sr-text-invert); margin-top: 24rpx; }
.pv__cost { font-size: 96rpx; font-weight: 900; color: var(--sr-gold); line-height: 1.2; margin-top: 12rpx; }
.pv__unit { font-size: 24rpx; color: var(--sr-dark-muted); margin-top: 4rpx; text-align: center; }
.pv__close { font-size: 22rpx; color: var(--sr-dark-muted); margin-top: 36rpx; }
