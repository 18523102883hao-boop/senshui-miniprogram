/* 管家服务 */
.head {
  background: linear-gradient(135deg, var(--sr-primary) 0%, #173628 100%);
  border-radius: var(--sr-radius-lg); padding: 44rpx 40rpx; margin-bottom: 28rpx;
}
.head__title { display: block; font-size: 38rpx; font-weight: 800; color: #F7F3EA; letter-spacing: 2rpx; }
.head__sub { display: block; font-size: 24rpx; color: rgba(247, 243, 234, 0.76); margin-top: 12rpx; line-height: 1.6; }
.head__hours {
  display: inline-flex; align-items: center; margin-top: 24rpx;
  padding: 10rpx 22rpx; border-radius: 30rpx;
  background: rgba(247, 243, 234, 0.12); font-size: 23rpx; color: rgba(247, 243, 234, 0.82);
}
.head__icon { width: 28rpx; height: 28rpx; margin-right: 10rpx; filter: brightness(0) invert(1); opacity: 0.85; }

.ch-list { display: flex; flex-direction: column; }
.ch {
  display: flex; align-items: center;
  background: var(--sr-bg-card); border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow); padding: 30rpx 32rpx; margin-bottom: 20rpx;
  text-align: left;
}
.ch--btn { line-height: normal; font-size: inherit; }
.ch--btn::after { border: none; }
.ch--primary { border-left: 8rpx solid var(--sr-primary); }
.ch__icon { width: 52rpx; height: 52rpx; flex-shrink: 0; }
.ch__body { flex: 1; display: flex; flex-direction: column; margin-left: 24rpx; min-width: 0; }
.ch__title { font-size: 29rpx; font-weight: 700; color: var(--sr-text); }
.ch__desc { font-size: 23rpx; color: var(--sr-text-sub); margin-top: 8rpx; }
.ch__arrow { font-size: 40rpx; color: var(--sr-text-weak); line-height: 1; }

.qr {
  display: flex; flex-direction: column; align-items: center;
  background: var(--sr-bg-card); border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow); padding: 36rpx; margin-top: 8rpx;
}
.qr__img { width: 380rpx; height: 380rpx; }
.qr__tip { font-size: 22rpx; color: var(--sr-text-weak); margin-top: 18rpx; }

.tail { font-size: 21rpx; color: var(--sr-text-weak); text-align: center; padding: 36rpx 0 40rpx; line-height: 1.6; }

/* 特色服务入口（从首页移入） */
.svc-entry { display: flex; align-items: center; background: var(--sr-bg-card);
  border-radius: var(--sr-radius); box-shadow: var(--sr-shadow); padding: 26rpx 32rpx; margin-bottom: 16rpx; }
.svc-entry__icon { width: 48rpx; height: 48rpx; flex-shrink: 0; }
.svc-entry__body { flex: 1; margin-left: 22rpx; min-width: 0; }
.svc-entry__title { display: block; font-size: 29rpx; font-weight: 600; color: var(--sr-text); }
.svc-entry__desc { display: block; font-size: 22rpx; color: var(--sr-text-sub); margin-top: 6rpx; }
