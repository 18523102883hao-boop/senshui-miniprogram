.tip { display: block; font-size: 24rpx; color: var(--sr-text-sub); line-height: 1.7; }

/* 时间筛选 */
.tabs { display: flex; gap: 12rpx; margin-bottom: 24rpx; }
.tab {
  flex: 1; text-align: center; padding: 18rpx 0; font-size: 26rpx;
  color: var(--sr-text-sub); background: var(--sr-bg-card);
  border-radius: var(--sr-radius-sm); box-shadow: var(--sr-shadow);
}
.tab--on { color: var(--sr-text-invert); background: var(--sr-primary); }

/* 总计 */
.total { display: flex; flex-direction: column; align-items: center; padding: 40rpx; }
.total__num { font-size: 64rpx; font-weight: 700; color: var(--sr-seal); }
.total__label { font-size: 24rpx; color: var(--sr-text-sub); margin-top: 8rpx; }

/* 表 */
.th { padding-bottom: 16rpx; border-bottom: 1rpx solid var(--sr-line); }
.th__name { flex: 1; font-size: 24rpx; color: var(--sr-text-weak); }
.th__count { width: 120rpx; text-align: center; font-size: 24rpx; color: var(--sr-text-weak); }
.th__amount { width: 160rpx; text-align: right; font-size: 24rpx; color: var(--sr-text-weak); }

.tr { padding: 24rpx 0; border-bottom: 1rpx solid var(--sr-line); }
.tr__name { flex: 1; display: flex; flex-direction: column; }
.tr__staff { font-size: 28rpx; color: var(--sr-text); }
.tr__no { font-size: 22rpx; color: var(--sr-text-weak); margin-top: 4rpx; }
.tr__count { width: 120rpx; text-align: center; font-size: 28rpx; color: var(--sr-text-sub); }
.tr__amount { width: 160rpx; text-align: right; font-size: 30rpx; font-weight: 700; color: var(--sr-primary); }

.sr-btn { margin-top: 8rpx; }
