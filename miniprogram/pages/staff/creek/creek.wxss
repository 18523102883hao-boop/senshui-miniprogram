.who { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.who__name { font-size: 32rpx; font-weight: 700; color: var(--sr-text); }
.who__date { font-size: 26rpx; color: var(--sr-primary); background: var(--sr-primary-weak); padding: 12rpx 24rpx; border-radius: 30rpx; }

.sec-title { display: block; font-size: 30rpx; font-weight: 700; color: var(--sr-text); margin: 20rpx 4rpx 18rpx; }

.sess {
  background: var(--sr-bg-card); border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow); padding: 26rpx 30rpx; margin-bottom: 18rpx;
  border-left: 8rpx solid transparent;
}
.sess--on { border-left-color: var(--sr-seal); }
.sess__head { display: flex; align-items: center; justify-content: space-between; }
.sess__time { font-size: 32rpx; font-weight: 800; color: var(--sr-text); }
.sess__status { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 8rpx; }
.sess__status--open { color: var(--sr-primary); background: var(--sr-primary-weak); }
.sess__status--closed { color: var(--sr-text-weak); background: var(--sr-bg-sunken); }
.sess__nums { display: flex; margin-top: 20rpx; }
.num { flex: 1; display: flex; flex-direction: column; align-items: center; }
.num__v { font-size: 34rpx; font-weight: 800; color: var(--sr-primary); line-height: 1.2; }
.num__k { font-size: 20rpx; color: var(--sr-text-weak); margin-top: 6rpx; }

.row { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid var(--sr-line); }
.row:last-of-type { border-bottom: none; }
.row__label { font-size: 27rpx; color: var(--sr-text); flex-shrink: 0; }
.row__value { font-size: 25rpx; color: var(--sr-text-sub); }
.row__input { flex: 1; text-align: right; font-size: 27rpx; color: var(--sr-text); margin-left: 24rpx; }

.btn { margin-top: 24rpx; text-align: center; padding: 26rpx 0; border-radius: 44rpx; background: var(--sr-primary); color: #fff; font-size: 29rpx; font-weight: 700; }
.btn--off { opacity: 0.6; }
.btn--ghost { background: transparent; color: var(--sr-primary); border: 2rpx solid var(--sr-primary); margin-bottom: 40rpx; }

.empty { text-align: center; font-size: 26rpx; color: var(--sr-text-weak); padding: 60rpx 0; }
.state { display: flex; flex-direction: column; align-items: center; padding: 140rpx 40rpx; }
.state__icon { width: 96rpx; height: 96rpx; opacity: 0.5; }
.state__text { font-size: 30rpx; color: var(--sr-text); margin-top: 24rpx; font-weight: 700; }
.state__sub { font-size: 23rpx; color: var(--sr-text-weak); margin-top: 12rpx; text-align: center; line-height: 1.6; }
