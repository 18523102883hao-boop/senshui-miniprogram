<view class="sr-page sr-enter">
  <view class="state" wx:if="{{checked && !allowed}}">
    <image class="state__icon" src="/assets/icons/status/status-warning.png" mode="aspectFit" />
    <text class="state__text">无溪降台账权限</text>
    <text class="state__sub">请用前台 / 溪降 / 管理员身份在「员工模式」登记</text>
  </view>

  <block wx:if="{{allowed}}">
    <view class="who">
      <text class="who__name">{{staffName}}</text>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="who__date">{{date}} ›</view>
      </picker>
    </view>

    <!-- 场次余位 + 台账 -->
    <text class="sec-title">场次余位与台账</text>
    <view class="sess {{insertSessionId === item._id ? 'sess--on' : ''}}"
          wx:for="{{sessions}}" wx:key="_id" data-id="{{item._id}}" bindtap="onSessionPick">
      <view class="sess__head">
        <text class="sess__time sr-num">{{item.startTime}}</text>
        <text class="sess__status sess__status--{{item.status}}">{{item.status === 'open' ? '开放' : '已关闭'}}</text>
      </view>
      <view class="sess__nums">
        <view class="num"><text class="num__v sr-num">{{item.remaining}}</text><text class="num__k">余位</text></view>
        <view class="num"><text class="num__v sr-num">{{item.booked}}</text><text class="num__k">已约</text></view>
        <view class="num"><text class="num__v sr-num">{{ledger[item._id].verified || 0}}</text><text class="num__k">已核销</text></view>
        <view class="num"><text class="num__v sr-num">{{ledger[item._id].total || 0}}</text><text class="num__k">应到</text></view>
        <view class="num" wx:if="{{ledger[item._id].front}}"><text class="num__v sr-num">{{ledger[item._id].front}}</text><text class="num__k">插单</text></view>
      </view>
    </view>
    <view class="empty" wx:if="{{!loading && !sessions.length}}">当日暂无场次</view>

    <!-- 前台插单 -->
    <block wx:if="{{canInsert}}">
      <text class="sec-title">前台插单（与线上同一库存池）</text>
      <view class="sr-card">
        <view class="row">
          <text class="row__label">选中场次</text>
          <text class="row__value">{{insertSessionId ? '已选择' : '点上方场次卡片选择'}}</text>
        </view>
        <view class="row">
          <text class="row__label">客人手机号</text>
          <input class="row__input" type="number" maxlength="11" placeholder="必填"
                 data-field="insertPhone" value="{{insertPhone}}" bindinput="onInsertInput" />
        </view>
        <view class="row">
          <text class="row__label">上车号码</text>
          <input class="row__input" maxlength="10" placeholder="必填"
                 data-field="insertBoardingNo" value="{{insertBoardingNo}}" bindinput="onInsertInput" />
        </view>
        <view class="row">
          <text class="row__label">券号</text>
          <input class="row__input" maxlength="40" placeholder="选填，渠道券号"
                 data-field="insertTicketNo" value="{{insertTicketNo}}" bindinput="onInsertInput" />
        </view>
        <view class="btn {{inserting ? 'btn--off' : ''}}" bindtap="onInsertSubmit">
          {{inserting ? '处理中…' : '确认插单'}}
        </view>
      </view>
    </block>

    <view class="btn btn--ghost" bindtap="goVerify">前往核销台</view>
  </block>
</view>
