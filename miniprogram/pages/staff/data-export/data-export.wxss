.export-page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.export-head,
.mode-tabs,
.range-card,
.dataset-card,
.export-note {
  border-radius: var(--sr-radius-lg);
  box-shadow: var(--sr-shadow);
}

.export-head {
  padding: var(--sr-gap-4);
  background: var(--sr-primary-deep);
  color: var(--sr-text-invert);
}

.export-head__eyebrow,
.export-head__title,
.export-head__desc,
.dataset-card__title text,
.export-note text {
  display: block;
}

.export-head__eyebrow {
  color: var(--sr-primary-light);
  font-size: 19rpx;
  font-weight: 740;
  letter-spacing: 2rpx;
}

.export-head__title {
  margin-top: var(--sr-gap-1);
  font-size: 38rpx;
  font-weight: 780;
}

.export-head__desc {
  margin-top: var(--sr-gap-2);
  color: var(--sr-text-invert);
  font-size: 21rpx;
  line-height: 1.7;
  opacity: .72;
}

.mode-tabs {
  display: flex;
  margin-top: var(--sr-gap-3);
  padding: var(--sr-gap-1);
  background: var(--sr-bg-card);
}

.mode-tab {
  flex: 1;
  padding: var(--sr-gap-2);
  border-radius: var(--sr-radius);
  color: var(--sr-text-sub);
  font-size: 23rpx;
  text-align: center;
}

.mode-tab--on {
  background: var(--sr-primary);
  color: var(--sr-text-invert);
  font-weight: 730;
}

.range-card,
.dataset-card,
.export-note {
  margin-top: var(--sr-gap-3);
  padding: var(--sr-gap-3);
  background: var(--sr-bg-card);
}

.range-card__summary,
.custom-range picker > view,
.dataset-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.range-card__summary {
  color: var(--sr-text-sub);
  font-size: 22rpx;
}

.range-card__summary text:last-child {
  color: var(--sr-text);
  font-weight: 700;
}

.custom-range {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--sr-gap-2);
  margin-top: var(--sr-gap-3);
}

.custom-range picker > view {
  padding: var(--sr-gap-2);
  border-radius: var(--sr-radius-sm);
  background: var(--sr-bg-sunken);
  color: var(--sr-text-weak);
  font-size: 19rpx;
}

.custom-range picker text:last-child {
  color: var(--sr-text);
}

.query-button {
  grid-column: 1 / -1;
  padding: var(--sr-gap-2);
  border-radius: var(--sr-radius-sm);
  background: var(--sr-primary);
  color: var(--sr-text-invert);
  font-size: 22rpx;
  font-weight: 720;
  text-align: center;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: var(--sr-gap-5) var(--sr-gap-1) var(--sr-gap-2);
}

.section-head text:first-child {
  color: var(--sr-text);
  font-size: 29rpx;
  font-weight: 760;
}

.section-head text:last-child {
  color: var(--sr-text-weak);
  font-size: 18rpx;
}

.dataset-card {
  border: 2rpx solid transparent;
}

.dataset-card--selected {
  border-color: var(--sr-primary);
}

.dataset-card__head {
  justify-content: flex-start;
  min-height: 76rpx;
}

.selection-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin-right: var(--sr-gap-2);
  border: 2rpx solid var(--sr-border);
  border-radius: var(--sr-radius-xs);
  color: var(--sr-text-invert);
  font-size: 24rpx;
  font-weight: 800;
}

.selection-box--on {
  border-color: var(--sr-primary);
  background: var(--sr-primary);
}

.dataset-card__title {
  flex: 1;
}

.dataset-card__title text:first-child {
  color: var(--sr-text);
  font-size: 25rpx;
  font-weight: 740;
}

.dataset-card__title text:last-child {
  margin-top: 4rpx;
  color: var(--sr-text-weak);
  font-size: 19rpx;
}

.field-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--sr-gap-1);
  margin-top: var(--sr-gap-2);
  padding-top: var(--sr-gap-2);
  border-top: 1rpx solid var(--sr-divider);
}

.field-chip {
  padding: 10rpx 16rpx;
  border-radius: var(--sr-radius-pill);
  background: var(--sr-bg-sunken);
  color: var(--sr-text-weak);
  font-size: 18rpx;
}

.field-chip--on {
  background: var(--sr-primary-soft);
  color: var(--sr-primary);
  font-weight: 680;
}

.field-chip--required {
  opacity: .82;
}

.export-note text:first-child {
  margin-bottom: var(--sr-gap-1);
  color: var(--sr-text);
  font-size: 23rpx;
  font-weight: 740;
}

.export-note text:not(:first-child) {
  color: var(--sr-text-sub);
  font-size: 19rpx;
  line-height: 1.75;
}

.export-bottom {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 5;
  padding: var(--sr-gap-3) var(--sr-page-x)
    calc(var(--sr-gap-3) + env(safe-area-inset-bottom));
  background: var(--sr-bg-card);
  box-shadow: var(--sr-shadow-up);
}

.export-button {
  width: 100%;
  margin: 0;
  border: 0;
  border-radius: var(--sr-radius-pill);
  background: var(--sr-primary);
  color: var(--sr-text-invert);
  font-size: 25rpx;
  font-weight: 760;
}

.export-button::after {
  border: 0;
}

.export-button[disabled] {
  background: var(--sr-primary);
  color: var(--sr-text-invert);
  opacity: .58;
}
