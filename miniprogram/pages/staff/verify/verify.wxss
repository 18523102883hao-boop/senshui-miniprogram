.scan-btn { width: 100%; margin-bottom: 24rpx; }

.vrow { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 0; border-bottom: 1rpx solid var(--sr-line); }
.vrow:last-child { border-bottom: none; }
.vrow__info { display: flex; flex-direction: column; }
.vrow__name { font-size: 28rpx; color: var(--sr-text); }
.vrow__state { font-size: 24rpx; color: var(--sr-text-sub); margin-top: 4rpx; }
.vrow__btn {
  margin: 0; height: 60rpx; line-height: 60rpx; padding: 0 32rpx;
  font-size: 26rpx; color: #fff; background: var(--sr-seal); border-radius: 30rpx;
}
.vrow__btn::after { border: none; }
.vrow__btn[disabled] { opacity: 0.5; }
.vrow__done { font-size: 24rpx; color: var(--sr-text-weak); }

.hint { text-align: center; color: var(--sr-text-weak); font-size: 26rpx; padding: 80rpx 0; }
