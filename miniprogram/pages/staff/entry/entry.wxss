page {
  background: var(--sr-dark-bg);
  color: var(--sr-dark-text);
}

.workbench {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--sr-dark-bg);
}

.state {
  min-height: 72vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.state__mark {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--sr-gold);
  margin-bottom: 32rpx;
}
.state__mark--pulse { animation: staff-pulse 1.4s ease-in-out infinite; }
.state__icon { width: 72rpx; height: 72rpx; margin-bottom: 24rpx; opacity: 0.76; }
.state__title { font-size: 34rpx; font-weight: 700; color: var(--sr-dark-text); }
.state__desc { margin-top: 10rpx; font-size: 24rpx; color: var(--sr-dark-muted); }
.state__button {
  min-width: 260rpx;
  min-height: 88rpx;
  margin-top: 40rpx;
  border: 1rpx solid var(--sr-dark-line);
  border-radius: 44rpx;
  background: var(--sr-dark-card-2);
  color: var(--sr-dark-text);
  font-size: 28rpx;
  font-weight: 650;
}
.state__button::after { border: none; }

.registration {
  margin-top: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  border: 1rpx solid var(--sr-dark-line);
  border-radius: var(--sr-radius-lg);
  background: var(--sr-dark-card);
}
.registration__head { display: flex; flex-direction: column; }
.registration__eyebrow,
.identity__eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--sr-gold);
}
.registration__title { margin-top: 12rpx; font-size: 44rpx; font-weight: 750; }
.registration__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--sr-dark-muted);
}
.registration__form { margin-top: 40rpx; }
.field {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--sr-dark-line);
}
.field__label { width: 152rpx; font-size: 26rpx; color: var(--sr-dark-muted); }
.field__input { flex: 1; font-size: 28rpx; color: var(--sr-dark-text); }
.field__placeholder { color: var(--sr-dark-muted); }
.registration__button {
  width: 100%;
  min-height: 88rpx;
  margin-top: 40rpx;
  border-radius: 44rpx;
  background: var(--sr-seal);
  color: var(--sr-dark-text);
  font-size: 30rpx;
  font-weight: 700;
}
.registration__button::after { border: none; }

.identity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 10rpx 4rpx 24rpx;
}
.identity__name-row { display: flex; align-items: center; margin-top: 4rpx; }
.identity__name { max-width: 360rpx; font-size: 38rpx; font-weight: 760; }
.identity__role {
  margin-left: 16rpx;
  padding: 4rpx 14rpx;
  border: 1rpx solid var(--sr-dark-line);
  border-radius: var(--sr-radius-sm);
  background: var(--sr-dark-card-2);
  color: var(--sr-dark-muted);
  font-size: 20rpx;
}
.identity__status { display: flex; align-items: center; font-size: 20rpx; color: var(--sr-dark-muted); }
.identity__dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: var(--sr-success);
}

.primary {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  min-height: 196rpx;
  box-sizing: border-box;
  padding: 32rpx;
  border: 1rpx solid rgba(213, 164, 58, 0.28);
  border-radius: var(--sr-radius-lg);
  background: var(--sr-dark-card);
}
.primary__glow {
  position: absolute;
  right: -130rpx;
  top: -190rpx;
  width: 430rpx;
  height: 430rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(213, 164, 58, 0.22) 0%, rgba(213, 164, 58, 0) 68%);
}
.primary__copy { z-index: 1; display: flex; flex: 1; flex-direction: column; margin-left: 24rpx; }
.primary__hint { color: var(--sr-gold); font-size: 20rpx; letter-spacing: 2rpx; }
.primary__title { margin-top: 4rpx; color: var(--sr-dark-text); font-size: 38rpx; font-weight: 760; }
.primary__desc { margin-top: 4rpx; color: var(--sr-dark-muted); font-size: 23rpx; }
.primary__arrow,
.manage-row__arrow { z-index: 1; color: var(--sr-dark-muted); font-size: 44rpx; font-weight: 300; }

.task-icon {
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--sr-dark-card-2);
}
.task-icon image { width: 40rpx; height: 40rpx; filter: brightness(0) invert(1); opacity: 0.92; }
.task-icon--primary { width: 88rpx; height: 88rpx; background: var(--sr-gold); }
.task-icon--primary image { width: 48rpx; height: 48rpx; filter: brightness(0); opacity: 0.72; }
.task-icon--manage { width: 64rpx; height: 64rpx; border-radius: 20rpx; }
.task-icon--manage image { width: 34rpx; height: 34rpx; opacity: 0.72; }

.section,
.dashboard { margin-top: 40rpx; }
.section__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 0 4rpx 20rpx;
}
.section__title { color: var(--sr-dark-text); font-size: 30rpx; font-weight: 720; }
.section__hint { color: var(--sr-dark-muted); font-size: 21rpx; }
.section__hint--warn { color: var(--sr-gold); }
.task-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.task-card {
  width: calc(50% - 8rpx);
  min-height: 224rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  border: 1rpx solid var(--sr-dark-line);
  border-radius: var(--sr-radius);
  background: var(--sr-dark-card);
}
.task-card__title { margin-top: 22rpx; color: var(--sr-dark-text); font-size: 28rpx; font-weight: 680; }
.task-card__desc { margin-top: 6rpx; color: var(--sr-dark-muted); font-size: 21rpx; line-height: 1.5; }

.dashboard {
  padding: 28rpx;
  border: 1rpx solid var(--sr-dark-line);
  border-radius: var(--sr-radius-lg);
  background: var(--sr-dark-card);
}
.dashboard .section__head { margin: 0 0 24rpx; }
.dashboard__hero {
  display: flex;
  flex-direction: column;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--sr-dark-line);
}
.dashboard__label { color: var(--sr-dark-muted); font-size: 22rpx; }
.dashboard__amount { margin-top: 4rpx; color: var(--sr-gold); font-size: 54rpx; font-weight: 780; line-height: 1.3; }
.metric-grid { display: flex; flex-wrap: wrap; }
.metric {
  width: 50%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-height: 112rpx;
  padding-top: 22rpx;
}
.metric__value { color: var(--sr-dark-text); font-size: 32rpx; font-weight: 720; }
.metric__label { color: var(--sr-dark-muted); font-size: 20rpx; }

.section--manage { margin-bottom: 24rpx; }
.manage-list {
  overflow: hidden;
  border: 1rpx solid var(--sr-dark-line);
  border-radius: var(--sr-radius);
  background: var(--sr-dark-card);
}
.manage-row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  box-sizing: border-box;
  margin: 0 24rpx;
  border-bottom: 1rpx solid var(--sr-dark-line);
}
.manage-row:last-child { border-bottom: none; }
.manage-row__copy { display: flex; flex: 1; flex-direction: column; margin-left: 20rpx; }
.manage-row__title { color: var(--sr-dark-text); font-size: 27rpx; font-weight: 650; }
.manage-row__desc { color: var(--sr-dark-muted); font-size: 20rpx; }

@keyframes staff-pulse {
  0%, 100% { opacity: 0.45; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.15); }
}
