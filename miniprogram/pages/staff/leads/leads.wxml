<view class="sr-page sr-enter">
  <sr-empty-state wx:if="{{checked && !allowed}}"
                  icon="help" title="无线索处理权限"
                  desc="请用前台或管理员身份在「员工模式」登记" />

  <block wx:if="{{allowed}}">
    <scroll-view class="filters" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="filter {{status === item.key ? 'filter--on' : ''}}"
            wx:for="{{filters}}" wx:key="key" data-key="{{item.key}}" bindtap="onFilterTap">
        {{item.title}}
      </view>
    </scroll-view>

    <view class="lead" wx:for="{{list}}" wx:key="leadId" data-id="{{item.leadId}}" bindtap="onLeadTap">
      <view class="lead__head">
        <text class="lead__type">{{typeText[item.type] || item.type}}</text>
        <text class="lead__status lead__status--{{item.status}}">{{statusText[item.status]}}</text>
      </view>
      <view class="lead__body">
        <text class="lead__name">{{item.contactName}}<text wx:if="{{item.company}}"> · {{item.company}}</text></text>
        <view class="lead__meta">
          <text wx:if="{{item.visitDate}}" class="sr-num">{{item.visitDate}}</text>
          <text wx:if="{{item.partySize}}"> · <text class="sr-num">{{item.partySize}}</text> 人</text>
          <text wx:if="{{item.budget}}"> · 预算 {{item.budget}}</text>
        </view>
        <text class="lead__follow" wx:if="{{item.nextFollowAt}}">下次跟进 {{item.nextFollowAt}}</text>
      </view>
      <view class="lead__foot">
        <text class="lead__phone sr-num" data-phone="{{item.contactPhone}}" catchtap="onCall">{{item.contactPhone}} 拨号</text>
        <text class="lead__hist" wx:if="{{item.historyCount}}">{{item.historyCount}} 条跟进</text>
      </view>
    </view>

    <view class="empty" wx:if="{{!loading && !list.length}}">当前筛选下没有线索</view>
  </block>

  <!-- 更新面板 -->
  <view class="mask" wx:if="{{activeLead}}" bindtap="closePanel">
    <view class="panel" catchtap="noop">
      <text class="panel__title">更新跟进</text>
      <text class="panel__sub">{{typeText[activeLead.type]}} · {{activeLead.contactName}}</text>

      <text class="panel__label">变更为</text>
      <view class="opts">
        <view class="opt {{editStatus === item.key ? 'opt--on' : ''}}"
              wx:for="{{nextOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="onStatusPick">
          {{item.title}}
        </view>
        <text class="opts__none" wx:if="{{!nextOptions.length}}">该线索已是终态，仅可补充备注</text>
      </view>

      <text class="panel__label">跟进备注</text>
      <textarea class="panel__ta" placeholder="沟通结果、客户诉求等" maxlength="200"
                value="{{editNote}}" bindinput="onNoteInput" />

      <picker mode="date" value="{{editNextFollow}}" bindchange="onFollowChange">
        <view class="panel__row">
          <text>下次跟进时间</text>
          <text class="panel__val">{{editNextFollow || '选填'}} ›</text>
        </view>
      </picker>

      <view class="panel__btn {{saving ? 'panel__btn--off' : ''}}" bindtap="onSaveUpdate">
        {{saving ? '保存中…' : '保存'}}
      </view>
      <view class="panel__cancel" bindtap="closePanel">取消</view>
    </view>
  </view>
</view>
