.staff-invoice-page {
  padding-bottom: calc(var(--sr-gap-8) + env(safe-area-inset-bottom));
}

.status-card {
  padding: var(--sr-gap-5);
  margin-bottom: var(--sr-gap-3);
  border-radius: var(--sr-radius-lg);
  background: var(--sr-primary-deep);
  color: var(--sr-text-invert);
  box-shadow: var(--sr-shadow);
}

.status-card--issued {
  background: var(--sr-primary);
}

.status-card--rejected,
.status-card--cancelled_refund {
  background: var(--sr-text-sub);
}

.status-card__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.status-card__eyebrow,
.status-card__title,
.status-card__desc,
.status-card__order {
  display: block;
}

.status-card__eyebrow {
  color: var(--sr-primary-light);
  font-size: 20rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
}

.status-card__title {
  margin-top: var(--sr-gap-1);
  font-size: 38rpx;
  font-weight: 750;
}

.status-card__amount {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.status-card__currency {
  font-size: 22rpx;
}

.status-card__number {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
}

.status-card__desc {
  margin-top: var(--sr-gap-4);
  padding-top: var(--sr-gap-3);
  border-top: 1rpx solid var(--sr-primary-light);
  font-size: 24rpx;
  line-height: 1.6;
  opacity: .8;
}

.status-card__order {
  margin-top: var(--sr-gap-1);
  font-size: 21rpx;
  opacity: .62;
}

.privacy-note {
  display: flex;
  align-items: flex-start;
  padding: var(--sr-gap-3);
  margin-bottom: var(--sr-gap-3);
  border-radius: var(--sr-radius-sm);
  background: var(--sr-primary-weak);
  color: var(--sr-primary);
  font-size: 23rpx;
  line-height: 1.6;
}

.privacy-note text {
  flex: 1;
  margin-left: var(--sr-gap-2);
}

.detail-card,
.action-card,
.result-card {
  padding: var(--sr-gap-4);
  margin-bottom: var(--sr-gap-3);
  border-radius: var(--sr-radius);
  background: var(--sr-bg-card);
  box-shadow: var(--sr-shadow);
}

.detail-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--sr-gap-2);
  border-bottom: 1rpx solid var(--sr-line);
}

.detail-card__title,
.action-card__title {
  color: var(--sr-text);
  font-size: 30rpx;
  font-weight: 700;
}

.detail-card__tag {
  padding: 5rpx 14rpx;
  border-radius: var(--sr-radius-sm);
  background: var(--sr-primary-weak);
  color: var(--sr-primary);
  font-size: 21rpx;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  padding: var(--sr-gap-3) 0;
  border-bottom: 1rpx solid var(--sr-line);
}

.detail-row--last {
  border-bottom: 0;
}

.detail-row__label {
  width: 152rpx;
  flex-shrink: 0;
  color: var(--sr-text-weak);
  font-size: 24rpx;
}

.detail-row__value {
  flex: 1;
  color: var(--sr-text);
  font-size: 25rpx;
  text-align: right;
  word-break: break-all;
}

.detail-row__value--num {
  font-variant-numeric: tabular-nums;
}

.action-card__title,
.action-card__desc {
  display: block;
}

.action-card__desc {
  margin: var(--sr-gap-1) 0 var(--sr-gap-3);
  color: var(--sr-text-sub);
  font-size: 23rpx;
}

.file-uploader {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 318rpx;
  padding: var(--sr-gap-4);
  margin: var(--sr-gap-3) 0;
  border: 2rpx dashed var(--sr-border);
  border-radius: var(--sr-radius-sm);
  background: var(--sr-bg-sunken);
}

.file-uploader__badge,
.file-ready__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: var(--sr-radius-sm);
  background: var(--sr-primary);
  color: var(--sr-text-invert);
  font-size: 20rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
}

.file-uploader__badge {
  width: 80rpx;
  height: 80rpx;
}

.file-uploader__title {
  margin-top: var(--sr-gap-2);
  color: var(--sr-text);
  font-size: 28rpx;
  font-weight: 700;
}

.file-uploader__desc {
  margin-top: 6rpx;
  color: var(--sr-text-weak);
  font-size: 22rpx;
}

.file-uploader__button {
  min-width: 260rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--sr-gap-4);
  margin-top: var(--sr-gap-3);
  border-radius: var(--sr-radius-lg);
  background: var(--sr-primary);
  color: var(--sr-text-invert);
  font-size: 25rpx;
  font-weight: 650;
}

.file-uploader__button::after,
.file-action::after {
  border: 0;
}

.file-ready {
  padding: var(--sr-gap-3);
  margin: var(--sr-gap-3) 0;
  border: 1rpx solid var(--sr-border);
  border-radius: var(--sr-radius-sm);
  background: var(--sr-bg-sunken);
}

.file-ready__main {
  display: flex;
  align-items: center;
}

.file-ready__badge {
  width: 68rpx;
  height: 68rpx;
}

.file-ready__copy {
  min-width: 0;
  flex: 1;
  margin-left: var(--sr-gap-2);
}

.file-ready__name,
.file-ready__meta {
  display: block;
}

.file-ready__name {
  overflow: hidden;
  color: var(--sr-text);
  font-size: 25rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-ready__meta {
  margin-top: 4rpx;
  color: var(--sr-text-weak);
  font-size: 21rpx;
}

.file-ready__state {
  margin-left: var(--sr-gap-2);
  color: var(--sr-success);
  font-size: 22rpx;
  font-weight: 650;
}

.file-ready__actions {
  display: flex;
  gap: var(--sr-gap-2);
  padding-top: var(--sr-gap-3);
  margin-top: var(--sr-gap-3);
  border-top: 1rpx solid var(--sr-line);
}

.file-action {
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 0 var(--sr-gap-2);
  margin: 0;
  border: 1rpx solid var(--sr-border);
  border-radius: var(--sr-radius-lg);
  background: var(--sr-bg-card);
  color: var(--sr-text-sub);
  font-size: 24rpx;
  font-weight: 650;
}

.file-action--primary {
  border-color: var(--sr-primary);
  color: var(--sr-primary);
}

.delivery-confirm {
  padding: var(--sr-gap-3);
  margin-bottom: var(--sr-gap-3);
  border-left: 4rpx solid var(--sr-primary);
  border-radius: var(--sr-radius-sm);
  background: var(--sr-primary-weak);
}

.delivery-confirm__title,
.delivery-confirm__desc {
  display: block;
}

.delivery-confirm__title {
  color: var(--sr-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.delivery-confirm__desc {
  margin-top: 4rpx;
  color: var(--sr-text-sub);
  font-size: 22rpx;
  line-height: 1.55;
}

.action-card--reject {
  border: 1rpx solid var(--sr-border);
}

.reject-input {
  width: 100%;
  min-height: 144rpx;
  box-sizing: border-box;
  padding: var(--sr-gap-3);
  margin-bottom: var(--sr-gap-3);
  border-radius: var(--sr-radius-sm);
  background: var(--sr-bg-sunken);
  color: var(--sr-text);
  font-size: 25rpx;
}

.reject-button {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--sr-danger);
  border-radius: var(--sr-radius-lg);
  background: var(--sr-bg-card);
  color: var(--sr-danger);
  font-size: 27rpx;
  font-weight: 650;
}

.reject-button::after {
  border: 0;
}

.result-card__label,
.result-card__value,
.result-card__meta {
  display: block;
}

.result-card__label {
  margin-top: var(--sr-gap-2);
  color: var(--sr-text-weak);
  font-size: 22rpx;
}

.result-card__label:first-child {
  margin-top: 0;
}

.result-card__value {
  margin-top: 4rpx;
  color: var(--sr-text);
  font-size: 29rpx;
  font-weight: 650;
}

.result-card__meta {
  margin-top: 6rpx;
  color: var(--sr-success);
  font-size: 22rpx;
}

.result-card__preview {
  width: 100%;
  margin-top: var(--sr-gap-3);
}

.result-card--reject {
  border-left: 6rpx solid var(--sr-danger);
}
