.cr-page { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.notice { background: rgba(213, 164, 58, 0.12); color: var(--sr-text); font-size: 23rpx; line-height: 1.7; padding: 22rpx 26rpx; border-radius: var(--sr-radius-sm); margin-bottom: 24rpx; }

.row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid var(--sr-line); }
.row:last-child { border-bottom: none; }
.row__label { font-size: 27rpx; color: var(--sr-text); flex-shrink: 0; }
.req { color: var(--sr-seal); }
.row__value { font-size: 27rpx; color: var(--sr-text-sub); }
.row__input { flex: 1; text-align: right; font-size: 27rpx; color: var(--sr-text); margin-left: 24rpx; }

.types { display: flex; flex-wrap: wrap; margin-top: 18rpx; }
.type {
  font-size: 25rpx; color: var(--sr-text-sub); background: var(--sr-bg-sunken);
  padding: 14rpx 26rpx; border-radius: 30rpx; margin-right: 16rpx; margin-bottom: 14rpx;
}
.type--on { background: var(--sr-primary); color: #fff; font-weight: 600; }

.remark { width: 100%; box-sizing: border-box; min-height: 150rpx; margin-top: 16rpx; font-size: 26rpx; color: var(--sr-text); }

.agree { display: flex; align-items: center; padding: 20rpx 8rpx 0; flex-wrap: wrap; }
.agree__box {
  width: 36rpx; height: 36rpx; border-radius: 8rpx; border: 2rpx solid var(--sr-text-weak);
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #fff; flex-shrink: 0;
}
.agree__box--on { background: var(--sr-primary); border-color: var(--sr-primary); }
.agree__text { font-size: 23rpx; color: var(--sr-text-sub); margin-left: 14rpx; }
.agree__link { font-size: 23rpx; color: var(--sr-primary); }

.bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--sr-bg-card); box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.bar__cta { text-align: center; padding: 26rpx 0; border-radius: 44rpx; background: var(--sr-primary); color: #fff; font-size: 30rpx; font-weight: 700; }
.bar__cta--off { opacity: 0.6; }

.state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.state__text { font-size: 28rpx; color: var(--sr-text); font-weight: 600; }
.state__btn { margin-top: 32rpx; padding: 18rpx 56rpx; border-radius: 40rpx; background: var(--sr-primary); color: #fff; font-size: 26rpx; font-weight: 600; }
