<view class="sr-page svc-page sr-enter">
  <view class="hero">
    <view class="hero__glow"></view>
    <text class="hero__title">{{title}}</text>
    <text class="hero__intro">{{fallbackIntro}}</text>
  </view>

  <view class="sr-card" wx:if="{{points.length}}">
    <text class="sr-subtitle">我们能做什么</text>
    <view class="sr-divider"></view>
    <view class="pt" wx:for="{{points}}" wx:key="*this">
      <view class="pt__dot"></view>
      <text class="pt__text">{{item}}</text>
    </view>
  </view>

  <!-- 云端配置的结构化内容（有就渲染，没有就只显示本地兜底） -->
  <block wx:for="{{blocks}}" wx:key="index">
    <text class="b-text" wx:if="{{item.type === 'text'}}">{{item.data.text}}</text>
    <view class="b-list sr-card" wx:elif="{{item.type === 'list'}}">
      <text class="b-list__title" wx:if="{{item.data.title}}">{{item.data.title}}</text>
      <view class="pt" wx:for="{{item.data.items}}" wx:key="*this" wx:for-item="li">
        <view class="pt__dot"></view>
        <text class="pt__text">{{li}}</text>
      </view>
    </view>
    <view class="b-grid" wx:elif="{{item.type === 'feature_grid'}}">
      <view class="b-grid__cell" wx:for="{{item.data.items}}" wx:key="title" wx:for-item="cell">
        <text class="b-grid__title">{{cell.title}}</text>
        <text class="b-grid__desc">{{cell.desc}}</text>
      </view>
    </view>
    <view class="b-notice" wx:elif="{{item.type === 'notice'}}">
      <text>{{item.data.text}}</text>
    </view>
  </block>

  <!-- 主行动：加顾问企微 + 电话；表单作为次要选项（业主决策：少让客户填）-->
  <sr-contact-card scene="{{qrScene}}"
                   title="加顾问微信，说清需求"
                   desc="方案、价格与档期一次沟通到位，比填表更快"
                   formRoute="/pages/service/lead/lead?type={{type}}"
                   formText="不方便加微信？填写需求表单" />

  <view class="tail">具体方案、价格与档期以管家沟通确认为准。</view>

  <!-- 底部栏与页面主行动保持一致：电话 + 加顾问微信（不再以填表为主 CTA） -->
  <view class="bar">
    <view class="bar__call sr-touch" hover-class="sr-touch--press" hover-stay-time="60" bindtap="onCallFront">
      <sr-icon name="mine-phone" theme="light" size="md" />
      <text>致电</text>
    </view>
    <view class="bar__cta sr-touch" hover-class="sr-touch--cta" hover-stay-time="60" bindtap="onContact">
      加顾问微信
    </view>
  </view>
</view>
