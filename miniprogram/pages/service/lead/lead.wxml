<view class="sr-page lead-page sr-enter">
  <!-- 成功态 -->
  <view class="done" wx:if="{{submitted}}">
    <image class="done__icon" src="/assets/icons/status/status-success.png" mode="aspectFit" />
    <text class="done__title">需求已提交</text>
    <text class="done__msg">管家会通过你留下的手机号与你联系，沟通具体方案。</text>
    <view class="done__btn" bindtap="goConcierge">联系管家</view>
    <view class="done__btn done__btn--ghost" bindtap="goHome">返回首页</view>
  </view>

  <block wx:else>
    <view class="sr-card">
      <block wx:for="{{fields}}" wx:key="key">
        <!-- 日期选择 -->
        <picker wx:if="{{item.type === 'date'}}" mode="date" value="{{form[item.key]}}"
                data-key="{{item.key}}" bindchange="onDateChange">
          <view class="row">
            <text class="row__label">{{item.label}}<text wx:if="{{item.required}}" class="req">*</text></text>
            <text class="row__value">{{form[item.key] || '请选择'}} ›</text>
          </view>
        </picker>

        <!-- 多行文本 -->
        <view wx:elif="{{item.type === 'textarea'}}" class="ta">
          <text class="row__label">{{item.label}}<text wx:if="{{item.required}}" class="req">*</text></text>
          <textarea class="ta__input" placeholder="{{item.placeholder || ''}}" maxlength="{{item.maxLength || 200}}"
                    value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="onFieldInput" />
        </view>

        <!-- 单行 / 数字 / 手机号 -->
        <view wx:else class="row">
          <text class="row__label">{{item.label}}<text wx:if="{{item.required}}" class="req">*</text></text>
          <input class="row__input"
                 type="{{item.type === 'number' || item.type === 'phone' ? 'number' : 'text'}}"
                 maxlength="{{item.type === 'phone' ? 11 : (item.maxLength || 40)}}"
                 placeholder="{{item.placeholder || ''}}"
                 value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="onFieldInput" />
        </view>
      </block>
    </view>

    <view class="agree">
      <view class="agree__box {{form.privacyAgreed ? 'agree__box--on' : ''}}" bindtap="onPrivacyToggle">
        <sr-icon wx:if="{{form.privacyAgreed}}" name="status-success" theme="status" size="sm" />
      </view>
      <text class="agree__text" bindtap="onPrivacyToggle">我已阅读并同意</text>
      <text class="agree__link" bindtap="goPrivacy">《隐私政策》</text>
    </view>

    <view class="bar">
      <view class="bar__cta {{submitting ? 'bar__cta--off' : ''}}" bindtap="onSubmit">
        {{submitting ? '提交中…' : '提交需求'}}
      </view>
    </view>
  </block>
</view>
