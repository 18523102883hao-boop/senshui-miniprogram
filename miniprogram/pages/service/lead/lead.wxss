.lead-page { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid var(--sr-line); }
.row:last-child { border-bottom: none; }
.row__label { font-size: 27rpx; color: var(--sr-text); flex-shrink: 0; }
.req { color: var(--sr-seal); margin-left: 6rpx; }
.row__value { font-size: 27rpx; color: var(--sr-text-sub); }
.row__input { flex: 1; text-align: right; font-size: 27rpx; color: var(--sr-text); margin-left: 24rpx; }

.ta { padding: 22rpx 0; border-bottom: 1rpx solid var(--sr-line); }
.ta:last-child { border-bottom: none; }
.ta__input { width: 100%; box-sizing: border-box; min-height: 150rpx; margin-top: 14rpx; font-size: 26rpx; color: var(--sr-text); }

.agree { display: flex; align-items: center; padding: 24rpx 8rpx; flex-wrap: wrap; }
.agree__box { width: 36rpx; height: 36rpx; border-radius: 8rpx; border: 2rpx solid var(--sr-text-weak);
  display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: #fff; flex-shrink: 0; }
.agree__box--on { background: var(--sr-primary); border-color: var(--sr-primary); }
.agree__text { font-size: 23rpx; color: var(--sr-text-sub); margin-left: 14rpx; }
.agree__link { font-size: 23rpx; color: var(--sr-primary); }

.done { display: flex; flex-direction: column; align-items: center; padding: 100rpx 40rpx; }
.done__icon { width: 120rpx; height: 120rpx; }
.done__title { font-size: 36rpx; font-weight: 800; color: var(--sr-text); margin-top: 32rpx; }
.done__msg { font-size: 25rpx; color: var(--sr-text-sub); margin-top: 16rpx; text-align: center; line-height: 1.7; }
.done__btn { width: 70%; text-align: center; padding: 24rpx 0; border-radius: 44rpx; background: var(--sr-primary);
  color: #fff; font-size: 29rpx; font-weight: 700; margin-top: 28rpx; }
.done__btn--ghost { background: transparent; color: var(--sr-primary); border: 2rpx solid var(--sr-primary); }

.bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--sr-bg-card); box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.06); }
.bar__cta { text-align: center; padding: 26rpx 0; border-radius: 44rpx; background: var(--sr-primary); color: #fff; font-size: 30rpx; font-weight: 700; }
.bar__cta--off { opacity: 0.6; }
