<view class="sr-page sr-enter">
  <sr-skeleton wx:if="{{loading}}" type="list" rows="3" />

  <view class="lead" wx:for="{{list}}" wx:key="leadId" wx:if="{{!loading && list.length}}">
    <view class="lead__head">
      <text class="lead__type">{{typeText[item.type] || '服务咨询'}}</text>
      <text class="lead__status lead__status--{{item.status}}">{{statusText[item.status] || item.status}}</text>
    </view>
    <text class="lead__summary" wx:if="{{item.summary}}">{{item.summary}}</text>
    <text class="lead__name">联系人 {{item.contactName}}</text>
  </view>

  <sr-empty-state wx:if="{{isEmpty && !loading && !hasError}}"
                  icon="edit" title="还没有提交过咨询"
                  desc="生日宴请、公司团建、品牌合作都可以在这里发起"
                  actionText="去看看服务" bind:action="goNew" />

  <sr-error-state wx:if="{{hasError && !loading}}" bind:retry="onRetry" />

  <view class="tail" wx:if="{{list.length}}">顾问会通过你留下的手机号联系你，如需加急可直接找管家。</view>
  <view class="ask sr-touch" wx:if="{{list.length}}" hover-class="sr-touch--press" hover-stay-time="60" bindtap="goConcierge">
    联系管家 ›
  </view>

  <!-- 常驻底部导航：二级页面也能直接切 Tab -->
  <sr-tabbar theme="light" />
</view>
