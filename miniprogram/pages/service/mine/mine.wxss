.lead { background: var(--sr-bg-card); border-radius: var(--sr-radius); box-shadow: var(--sr-shadow);
  padding: 28rpx 32rpx; margin-bottom: 20rpx; border-left: 8rpx solid var(--sr-primary); }
.lead__head { display: flex; align-items: center; justify-content: space-between; }
.lead__type { font-size: 29rpx; font-weight: 650; color: var(--sr-text); }
.lead__status { font-size: 22rpx; padding: 6rpx 18rpx; border-radius: var(--sr-radius-sm);
  background: var(--sr-bg-sunken); color: var(--sr-text-sub); }
.lead__status--new { background: rgba(240,112,85,0.14); color: var(--sr-seal); font-weight: 600; }
.lead__status--won { background: rgba(54,182,106,0.16); color: #2E9E5B; font-weight: 600; }
.lead__summary { display: block; font-size: 24rpx; color: var(--sr-text-sub); margin-top: 12rpx; }
.lead__name { display: block; font-size: 22rpx; color: var(--sr-text-weak); margin-top: 8rpx; }
.tail { font-size: 21rpx; color: var(--sr-text-weak); text-align: center; padding: 24rpx 0 16rpx; line-height: 1.6; }
.ask { text-align: center; font-size: 26rpx; color: var(--sr-primary); font-weight: 600; padding: 20rpx 0 40rpx; }

/* 常驻底部导航避让 */
.sr-page { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)) !important; }
