.legal { padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }
.legal__head { padding: 16rpx 8rpx 24rpx; }
.legal__title { display: block; font-size: 48rpx; font-weight: 800; color: var(--sr-text); letter-spacing: 1rpx; }
.legal__meta { display: block; margin-top: 12rpx; font-size: 22rpx; color: var(--sr-text-weak); line-height: 1.6; }
.legal__lead {
  padding: 28rpx; margin-bottom: 24rpx;
  border-radius: var(--sr-radius); background: var(--sr-primary-weak);
  font-size: 25rpx; color: var(--sr-primary); line-height: 1.75;
}
.legal__section { padding: 32rpx; }
.legal__section-title { display: block; font-size: 30rpx; font-weight: 700; color: var(--sr-text); margin-bottom: 12rpx; }
.legal__item { display: flex; align-items: flex-start; padding: 12rpx 0; }
.legal__dot { flex-shrink: 0; width: 26rpx; font-size: 26rpx; color: var(--sr-gold); font-weight: 700; }
.legal__text { flex: 1; font-size: 26rpx; color: var(--sr-text-sub); line-height: 1.8; }
.legal__foot { text-align: center; font-size: 23rpx; color: var(--sr-text-weak); padding: 24rpx 16rpx; line-height: 1.7; }
