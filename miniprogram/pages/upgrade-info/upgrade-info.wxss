/* ===== 套票价 hero ===== */
.hero {
  background: linear-gradient(135deg, #244B36, #173628);
  border-radius: var(--sr-radius-lg); padding: 40rpx; margin-bottom: 24rpx;
  display: flex; flex-direction: column; position: relative; overflow: hidden;
}
.hero__tagline { font-size: 24rpx; color: rgba(247, 243, 234, 0.8); }
.hero__combo { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.hero__names { display: flex; align-items: center; gap: 12rpx; }
.hero__name {
  font-size: 34rpx; font-weight: 800; color: #F7F3EA;
  background: rgba(213, 164, 58, 0.18); border: 1rpx solid rgba(213, 164, 58, 0.4);
  padding: 6rpx 24rpx; border-radius: 14rpx;
}
.hero__plus { font-size: 30rpx; color: var(--sr-gold-light); font-weight: 700; }
.hero__pkg { font-size: 24rpx; color: var(--sr-gold-light); }

.hero__price { display: flex; align-items: flex-end; margin-top: 28rpx; }
.hero__cur { font-size: 40rpx; font-weight: 700; color: var(--sr-gold-light); margin-bottom: 8rpx; }
.hero__num { font-size: 96rpx; font-weight: 900; color: var(--sr-gold-light); line-height: 0.9; margin-left: 4rpx; }
.hero__price-side { display: flex; flex-direction: column; margin-left: 24rpx; margin-bottom: 8rpx; }
.hero__orig { font-size: 24rpx; color: rgba(247, 243, 234, 0.55); text-decoration: line-through; }
.hero__save { font-size: 24rpx; color: var(--sr-seal-light); font-weight: 700; margin-top: 6rpx; }

/* ===== 分组标题 ===== */
.grp-head { display: flex; align-items: center; margin-bottom: 8rpx; }
.grp-head__bar { width: 6rpx; height: 30rpx; border-radius: 4rpx; background: var(--sr-primary); margin-right: 14rpx; }
.grp-head__title { font-size: 32rpx; font-weight: 700; color: var(--sr-text); }

/* ===== 升级项卡 ===== */
.upg { padding: 30rpx 0; border-bottom: 1rpx solid var(--sr-line); }
.upg:last-child { border-bottom: none; padding-bottom: 8rpx; }
.upg__main { display: flex; justify-content: space-between; align-items: flex-start; }
.upg__info { display: flex; flex-direction: column; flex: 1; padding-right: 20rpx; }
.upg__name { font-size: 32rpx; font-weight: 700; color: var(--sr-text); }
.upg__orig { font-size: 24rpx; color: var(--sr-text-weak); margin-top: 8rpx; }
.upg__price {
  flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end;
  background: rgba(240, 112, 85, 0.09);
  border: 1rpx solid rgba(240, 112, 85, 0.26);
  border-radius: 18rpx; padding: 12rpx 22rpx; max-width: 320rpx;
}
.upg__price-label { font-size: 20rpx; color: var(--sr-seal); opacity: 0.9; }
.upg__price-num { font-size: 34rpx; font-weight: 800; color: var(--sr-seal); line-height: 1.15; text-align: right; }

.upg__benefit { display: flex; align-items: flex-start; margin-top: 18rpx; }
.upg__benefit-icon { width: 30rpx; height: 30rpx; margin-right: 12rpx; margin-top: 4rpx; flex-shrink: 0; }
.upg__benefit-text { flex: 1; font-size: 24rpx; color: var(--sr-text-sub); line-height: 1.65; }

/* ===== 升级后权益 ===== */
.ben { display: flex; align-items: flex-start; padding: 12rpx 0; }
.ben__ico { width: 32rpx; height: 32rpx; margin-right: 14rpx; margin-top: 2rpx; flex-shrink: 0; }
.ben__text { flex: 1; font-size: 26rpx; color: var(--sr-text-sub); line-height: 1.7; }

/* ===== 为什么升级 ===== */
.reason { display: flex; align-items: baseline; padding: 14rpx 0; }
.reason__t { flex-shrink: 0; width: 120rpx; font-size: 28rpx; font-weight: 700; color: var(--sr-primary); }
.reason__d { flex: 1; font-size: 24rpx; color: var(--sr-text-sub); line-height: 1.6; }

.foot { text-align: center; font-size: 24rpx; color: var(--sr-text-weak); padding: 24rpx 16rpx; line-height: 1.6; }
