<view class="sr-page sr-enter">
  <!-- 套票价（升级锚点） -->
  <view class="hero">
    <text class="hero__tagline">已购单项票？现场补差即可升级</text>
    <view class="hero__combo">
      <view class="hero__names">
        <text class="hero__name">溪降</text>
        <text class="hero__plus">+</text>
        <text class="hero__name">营地</text>
      </view>
      <text class="hero__pkg">双项套票</text>
    </view>
    <view class="hero__price">
      <text class="hero__cur">¥</text>
      <text class="hero__num sr-num">{{comboPrice}}</text>
      <view class="hero__price-side">
        <text class="hero__orig sr-num">原价 ¥{{originalPrice}}</text>
        <text class="hero__save">立省 ¥{{saved}}</text>
      </view>
    </view>
  </view>

  <!-- 升级明细（整行点按购买） -->
  <view class="sr-card" wx:for="{{groups}}" wx:for-index="gi" wx:key="dir">
    <view class="grp-head">
      <view class="grp-head__bar"></view>
      <text class="grp-head__title">{{item.dir}}</text>
    </view>
    <view class="upg sr-touch" hover-class="sr-touch--press" hover-stay-time="60"
          wx:for="{{item.items}}" wx:for-item="it" wx:for-index="ii" wx:key="itemId"
          data-gi="{{gi}}" data-ii="{{ii}}" bindtap="onItemTap">
      <view class="upg__info">
        <text class="upg__name">{{it.name}}</text>
        <text class="upg__benefit">{{it.benefit}}</text>
        <text class="upg__orig sr-num">原价 ¥{{it.orig}}</text>
      </view>
      <view class="upg__right">
        <text class="upg__add sr-num">{{it.add}}</text>
        <view class="upg__cta">立即补差 ›</view>
      </view>
    </view>
  </view>

  <!-- 升级后权益 -->
  <view class="sr-card">
    <view class="grp-head">
      <view class="grp-head__bar"></view>
      <text class="grp-head__title">升级后权益</text>
    </view>
    <view class="ben" wx:for="{{benefits}}" wx:for-item="b" wx:key="*this">
      <image class="ben__ico" src="/assets/icons/status/status-success.png" mode="aspectFit" />
      <text class="ben__text">{{b}}</text>
    </view>
  </view>

  <view class="foot">线上支付后凭微信支付凭证升级，也可到游客中心 / 前台咨询办理。</view>

  <!-- 底部购买面板 -->
  <view class="sheet-mask" wx:if="{{buy}}" bindtap="closeBuy">
    <view class="sheet" catchtap="noop">
      <view class="sheet__grab"></view>
      <text class="sheet__name">{{buy.name}}</text>
      <text class="sheet__benefit">{{buy.benefit}}</text>
      <view class="sheet__price">
        <text class="sheet__price-label">补差价</text>
        <text class="sheet__price-num sr-num">{{buy.add}}</text>
      </view>
      <view class="sheet__field">
        <text class="sheet__field-label">接待员工</text>
        <input class="sheet__input" value="{{staffRef}}" bindinput="onStaffRef"
               placeholder="员工姓名或手机号（没有可不填）" placeholder-class="sheet__ph" />
      </view>
      <button class="sr-btn sr-btn--seal sheet__pay" bindtap="onPay" loading="{{paying}}" disabled="{{paying}}">
        微信支付 {{buy.add}}
      </button>
      <text class="sheet__safe">支付将通过微信安全支付完成，款项进入森水长河官方账户。</text>
    </view>
  </view>
</view>
