<view class="sr-page">
  <!-- 套票价 -->
  <view class="hero">
    <text class="hero__label">已购单项票？现场补差即可升级为「溪降 + 营地」套票</text>
    <view class="hero__price">
      <text class="hero__cur">¥</text><text class="hero__num">{{comboPrice}}</text>
      <text class="hero__orig">原价 ¥{{originalPrice}}</text>
    </view>
  </view>

  <!-- 各方向升级明细 -->
  <view class="sr-card" wx:for="{{groups}}" wx:key="dir">
    <text class="sr-subtitle">{{item.dir}}</text>
    <view class="sr-divider"></view>
    <view class="up" wx:for="{{item.items}}" wx:for-item="it" wx:key="name">
      <view class="up__head">
        <view class="up__left">
          <text class="up__name">{{it.name}}</text>
          <text class="up__orig">原价 ¥{{it.orig}}</text>
        </view>
        <view class="up__add">补差 {{it.add}}</view>
      </view>
      <text class="up__benefit">{{it.benefit}}</text>
    </view>
  </view>

  <!-- 升级后权益 -->
  <view class="sr-card">
    <text class="sr-subtitle">升级后权益</text>
    <view class="sr-divider"></view>
    <view class="ben" wx:for="{{benefits}}" wx:for-item="b" wx:key="*this">
      <text class="ben__ico">✓</text><text class="ben__text">{{b}}</text>
    </view>
  </view>

  <!-- 为什么升级 -->
  <view class="sr-card">
    <text class="sr-subtitle">为什么现在升级</text>
    <view class="sr-divider"></view>
    <view class="reason" wx:for="{{reasons}}" wx:for-item="r" wx:key="t">
      <text class="reason__t">{{r.t}}</text>
      <text class="reason__d">{{r.d}}</text>
    </view>
  </view>

  <view class="foot">请到游客中心 / 前台咨询办理，现场补差即享双重体验。</view>
</view>
