.card {
  background: linear-gradient(135deg, #2A4D3A, #1F3A2C);
  border-radius: var(--sr-radius); padding: 40rpx; margin-bottom: 24rpx;
}
.card__head { display: flex; align-items: center; justify-content: space-between; }
.card__title { font-size: 34rpx; font-weight: 700; color: #F5D98B; }
.card__status { font-size: 24rpx; color: #fff; background: rgba(245,217,139,0.2); padding: 4rpx 16rpx; border-radius: 20rpx; }
.card__expire { display: block; font-size: 24rpx; color: rgba(255,255,255,0.7); margin-top: 12rpx; }

.card__qr { margin-top: 32rpx; background: #fff; border-radius: var(--sr-radius-sm); padding: 40rpx; display: flex; flex-direction: column; align-items: center; }
.card__qr-box {
  width: 320rpx; height: 320rpx; border-radius: 12rpx;
  background: var(--sr-bg-sunken); color: var(--sr-text-weak);
  display: flex; align-items: center; justify-content: center; font-size: 28rpx;
}
.card__qr-canvas { width: 320rpx; height: 320rpx; }
.card__qr-tip { font-size: 24rpx; color: var(--sr-text); font-weight: 600; margin-top: 20rpx; }
.card__qr-sub { font-size: 22rpx; color: var(--sr-text-weak); margin-top: 6rpx; }

.ben { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid var(--sr-line); }
.ben:last-child { border-bottom: none; }
.ben__name { font-size: 28rpx; color: var(--sr-text); }
.ben__state { font-size: 26rpx; color: var(--sr-seal); }
.ben__state.is-done { color: var(--sr-text-weak); }

.footer { margin-top: 24rpx; }

.empty-card { padding: 120rpx 40rpx; display: flex; flex-direction: column; align-items: center; }
.empty-card__text { font-size: 28rpx; color: var(--sr-text-sub); margin-bottom: 40rpx; }
.empty-card__btn { width: 60%; }
