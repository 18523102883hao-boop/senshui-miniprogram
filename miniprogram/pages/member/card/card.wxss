.card { border-radius: var(--sr-radius-lg); padding: 44rpx 40rpx; margin-bottom: 24rpx; }
.card__head { display: flex; align-items: center; justify-content: space-between; }
.card__brand { display: flex; align-items: center; gap: 14rpx; }
.card__title { font-size: 34rpx; font-weight: 800; color: var(--sr-gold-light); letter-spacing: 2rpx; }
.card__badge { font-size: 20rpx; font-weight: 700; color: #173628; background: var(--sr-gold); border-radius: 6rpx; padding: 2rpx 12rpx; }
.card__status { font-size: 24rpx; color: var(--sr-gold-light); background: rgba(213,164,58,0.16); border: 1rpx solid rgba(213,164,58,0.3); padding: 4rpx 18rpx; border-radius: 20rpx; }
.card__expire { display: block; font-size: 24rpx; color: rgba(247,243,234,0.68); margin-top: 14rpx; }

.card__qr { margin-top: 32rpx; background: #fff; border-radius: var(--sr-radius-sm); padding: 40rpx; display: flex; flex-direction: column; align-items: center; }
.card__qr-box {
  width: 320rpx; height: 320rpx; border-radius: 12rpx;
  background: var(--sr-bg-sunken); color: var(--sr-text-weak);
  display: flex; align-items: center; justify-content: center; font-size: 28rpx;
}
.card__qr-canvas { width: 320rpx; height: 320rpx; }
.card__qr-tip { font-size: 24rpx; color: var(--sr-text); font-weight: 600; margin-top: 20rpx; }
.card__qr-sub { font-size: 22rpx; color: var(--sr-text-weak); margin-top: 6rpx; }

.ben { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid var(--sr-line); }
.ben:last-child { border-bottom: none; }
.ben__icon { width: 40rpx; height: 40rpx; flex-shrink: 0; margin-right: 18rpx; }
.ben__name { flex: 1; font-size: 28rpx; color: var(--sr-text); }
.ben__state { font-size: 26rpx; color: var(--sr-gold); font-weight: 600; }
.ben__state.is-done { color: var(--sr-text-weak); font-weight: 400; }

.footer { margin-top: 24rpx; }

.empty-card { padding: 120rpx 40rpx; display: flex; flex-direction: column; align-items: center; }
.empty-card__text { font-size: 28rpx; color: var(--sr-text-sub); margin-bottom: 40rpx; }
.empty-card__btn { width: 60%; }

/* 常驻底部导航避让 */
.sr-page { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)) !important; }
