/* 溪降预约 - 创建预约 */
.container {
  padding: 20rpx;
  background-color: #F6F4F0;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 卡片通用样式 */
.session-info-card,
.form-card,
.notice-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #244B36;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #E8E3D8;
}

/* 信息行 */
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #8A8072;
}

.info-value {
  font-size: 28rpx;
  color: #2B2B2B;
  font-weight: 500;
}

.info-value.warning {
  color: #F07055;
  font-weight: bold;
}

/* 表单 */
.form-item {
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 28rpx;
  color: #2B2B2B;
  margin-bottom: 16rpx;
  display: block;
}

.form-input {
  background: white;
  border: 1rpx solid #E8E3D8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.form-tip {
  font-size: 24rpx;
  color: #8A8072;
  margin-top: 16rpx;
}

/* 注意事项 */
.notice-item {
  display: flex;
  margin-bottom: 16rpx;
  align-items: flex-start;
}

.notice-dot {
  color: #244B36;
  margin-right: 12rpx;
  font-size: 28rpx;
}

.notice-text {
  font-size: 26rpx;
  color: #6B6B6B;
  line-height: 1.6;
  flex: 1;
}

/* 提交按钮 */
.submit-btn {
  position: fixed;
  bottom: 40rpx;
  left: 20rpx;
  right: 20rpx;
  background: #244B36;
  color: white;
  text-align: center;
  padding: 28rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(42, 77, 58, 0.3);
}

.submit-btn.disabled {
  background: #C8C4BC;
  box-shadow: none;
}
