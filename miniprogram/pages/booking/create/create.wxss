.bk-page { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.row { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid var(--sr-line); }
.row:last-child { border-bottom: none; }
.row__label { font-size: 27rpx; color: var(--sr-text); flex-shrink: 0; }
.row__value { font-size: 27rpx; color: var(--sr-text-sub); }
.row__input { flex: 1; text-align: right; font-size: 27rpx; color: var(--sr-text); margin-left: 24rpx; }
.hint { display: block; font-size: 21rpx; color: var(--sr-text-weak); line-height: 1.6; margin-top: 14rpx; }

.ticket-ok { display: flex; align-items: center; font-size: 25rpx; color: var(--sr-text); line-height: 1.6; margin-top: 16rpx; }
.ticket-ok__icon { width: 40rpx; height: 40rpx; flex-shrink: 0; margin-right: 14rpx; }

.check { display: flex; align-items: center; padding: 18rpx 0; }
.check--sub { padding-left: 40rpx; }
.check__box {
  width: 36rpx; height: 36rpx; border-radius: 8rpx; border: 2rpx solid var(--sr-text-weak);
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #fff; flex-shrink: 0;
}
.check__box--on { background: var(--sr-primary); border-color: var(--sr-primary); }
.check__text { font-size: 25rpx; color: var(--sr-text); margin-left: 16rpx; line-height: 1.5; }
.check__link { display: block; font-size: 23rpx; color: var(--sr-primary); padding-left: 52rpx; }

.bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--sr-bg-card); box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.bar__cta { text-align: center; padding: 26rpx 0; border-radius: 44rpx; background: var(--sr-primary); color: #fff; font-size: 30rpx; font-weight: 700; }
.bar__cta--off { opacity: 0.6; }
