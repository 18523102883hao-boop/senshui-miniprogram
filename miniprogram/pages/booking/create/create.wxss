.submit-wrapper {
  padding-top: 8rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.sec-head {
  display: flex;
  align-items: center;
}

.sec-head__bar {
  width: 6rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: var(--sr-seal);
  margin-right: 14rpx;
}

.sec-head__icon {
  opacity: 0.8;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: var(--sr-text-sub);
}

.info-value {
  font-size: 28rpx;
  color: var(--sr-text);
  font-weight: 600;
}

.info-value--warning {
  color: var(--sr-seal);
  font-weight: 700;
}

.info-divider {
  height: 1rpx;
  background: var(--sr-line);
}

.form-item {
  margin-top: 20rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--sr-text);
  margin-bottom: 16rpx;
  display: block;
  font-weight: 500;
}

.form-input {
  background: var(--sr-bg-sunken);
  border-radius: var(--sr-radius-sm);
  padding: 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  color: var(--sr-text);
}

.form-tip {
  display: block;
  font-size: 24rpx;
  color: var(--sr-text-weak);
  margin-top: 20rpx;
}

.notice-item {
  display: flex;
  margin-bottom: 20rpx;
  align-items: flex-start;
}

.notice-item:last-child {
  margin-bottom: 0;
}

.notice-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--sr-primary);
  margin-top: 10rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notice-text {
  font-size: 26rpx;
  color: var(--sr-text-sub);
  line-height: 1.6;
  flex: 1;
}
