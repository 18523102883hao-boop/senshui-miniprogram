<view class="sr-page sr-enter">
  <view class="sr-card">
    <view class="sr-row-between">
      <view class="sec-head">
        <view class="sec-head__bar"></view>
        <text class="sr-subtitle">场次信息</text>
      </view>
      <image class="sr-icon--sm sec-head__icon" src="/assets/icons/forest/booking-time.png" mode="aspectFit" />
    </view>
    
    <view class="info-row">
      <text class="info-label">日期</text>
      <text class="info-value">{{formatDate(session.date)}}</text>
    </view>
    <view class="info-divider"></view>
    <view class="info-row">
      <text class="info-label">时间</text>
      <text class="info-value">{{session.startTime}}</text>
    </view>
    <view class="info-divider"></view>
    <view class="info-row">
      <text class="info-label">剩余名额</text>
      <text class="info-value info-value--warning">{{session.remaining}}</text>
    </view>
  </view>

  <view class="sr-card">
    <view class="sr-row-between">
      <view class="sec-head">
        <view class="sec-head__bar"></view>
        <text class="sr-subtitle">预约信息</text>
      </view>
      <image class="sr-icon--sm sec-head__icon" src="/assets/icons/forest/mine-phone.png" mode="aspectFit" />
    </view>
    
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input 
        class="form-input" 
        type="number" 
        maxlength="11" 
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>
    <text class="form-tip">预约成功后，预约码将发送至该手机号</text>
  </view>

  <view class="sr-card">
    <view class="sr-row-between">
      <view class="sec-head">
        <view class="sec-head__bar"></view>
        <text class="sr-subtitle">注意事项</text>
      </view>
      <image class="sr-icon--sm sec-head__icon" src="/assets/icons/forest/booking-safety.png" mode="aspectFit" />
    </view>
    
    <view class="notice-item">
      <view class="notice-dot"></view>
      <text class="notice-text">预约成功后可在"我的预约"中查看预约码</text>
    </view>
    <view class="notice-item">
      <view class="notice-dot"></view>
      <text class="notice-text">每人每场限预约 1 次，最多可改签 1 次</text>
    </view>
    <view class="notice-item">
      <view class="notice-dot"></view>
      <text class="notice-text">请提前 15 分钟到达现场核销入场</text>
    </view>
    <view class="notice-item">
      <view class="notice-dot"></view>
      <text class="notice-text">如遇天气原因停运，将统一发送通知</text>
    </view>
  </view>

  <view class="submit-wrapper">
    <view 
      class="sr-btn sr-touch {{!phone || phone.length !== 11 ? 'sr-btn--disabled' : ''}}" 
      hover-class="sr-touch--cta" 
      hover-stay-time="60"
      bindtap="onSubmit"
    >
      <text>确认预约</text>
    </view>
  </view>
</view>
