<view class="sr-page bk-page sr-enter">
  <!-- 场次信息 -->
  <view class="sr-card" wx:if="{{session._id}}">
    <text class="sr-subtitle">预约场次</text>
    <view class="sr-divider"></view>
    <view class="row"><text class="row__label">日期</text><text class="row__value sr-num">{{session.date}}</text></view>
    <view class="row"><text class="row__label">开始时间</text><text class="row__value sr-num">{{session.startTime}}</text></view>
    <view class="row"><text class="row__label">剩余名额</text><text class="row__value sr-num">{{session.remaining}}</text></view>
  </view>

  <!-- 购票凭证 -->
  <view class="sr-card">
    <text class="sr-subtitle">购票凭证</text>
    <view class="sr-divider"></view>
    <view class="ticket-ok" wx:if="{{hasNativeTicket}}">
      <image class="ticket-ok__icon" src="/assets/icons/status/status-success.png" mode="aspectFit" />
      <text>已识别到你的溪降票 <text class="sr-num">{{nativeTicketNo}}</text>，预约将自动关联</text>
    </view>
    <block wx:else>
      <view class="row">
        <text class="row__label">渠道券号</text>
        <input class="row__input" maxlength="40" placeholder="抖音/美团券号"
               value="{{externalTicketNo}}" bindinput="onExternalTicketInput" />
      </view>
      <text class="hint">你在小程序内没有可用的溪降票。若已在其他渠道购票，请填写券号，入园时以现场核验为准。</text>
    </block>
  </view>

  <!-- 联系方式 -->
  <view class="sr-card">
    <view class="row">
      <text class="row__label">手机号</text>
      <input class="row__input" type="number" maxlength="11" placeholder="用于现场联系"
             value="{{phone}}" bindinput="onPhoneInput" />
    </view>
  </view>

  <!-- 安全确认 -->
  <view class="sr-card">
    <text class="sr-subtitle">安全确认</text>
    <view class="sr-divider"></view>
    <view class="check" bindtap="onSafetyToggle">
      <view class="check__box {{safetyConfirmed ? 'check__box--on' : ''}}"><text wx:if="{{safetyConfirmed}}">✓</text></view>
      <text class="check__text">我已阅读并确认溪降安全须知</text>
    </view>
    <text class="check__link" bindtap="goNotice">查看《溪降须知》›</text>

    <view class="check" bindtap="onWithChildToggle">
      <view class="check__box {{withChild ? 'check__box--on' : ''}}"><text wx:if="{{withChild}}">✓</text></view>
      <text class="check__text">本次携带儿童参与</text>
    </view>
    <view class="check check--sub" wx:if="{{withChild}}" bindtap="onChildToggle">
      <view class="check__box {{childConfirmed ? 'check__box--on' : ''}}"><text wx:if="{{childConfirmed}}">✓</text></view>
      <text class="check__text">儿童身高符合要求，且全程由监护人陪同</text>
    </view>
  </view>

  <view class="bar">
    <view class="bar__cta {{submitting ? 'bar__cta--off' : ''}}" bindtap="onSubmit">
      {{submitting ? '预约中…' : '确认预约'}}
    </view>
  </view>
</view>
