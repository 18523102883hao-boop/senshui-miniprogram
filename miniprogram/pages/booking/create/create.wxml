<!-- 溪降预约 - 创建预约 -->
<view class="container">
  <!-- 场次信息 -->
  <view class="session-info-card">
    <view class="card-title">场次信息</view>
    <view class="info-row">
      <text class="info-label">日期</text>
      <text class="info-value">{{formatDate(session.date)}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">时间</text>
      <text class="info-value">{{session.startTime}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">剩余名额</text>
      <text class="info-value warning">{{session.remaining}}</text>
    </view>
  </view>

  <!-- 预约表单 -->
  <view class="form-card">
    <view class="card-title">预约信息</view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input 
        class="form-input" 
        type="number" 
        maxlength="11" 
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>
    <view class="form-tip">
      <text>预约成功后，预约码将发送至该手机号</text>
    </view>
  </view>

  <!-- 注意事项 -->
  <view class="notice-card">
    <view class="card-title">注意事项</view>
    <view class="notice-item">
      <text class="notice-dot">•</text>
      <text class="notice-text">预约成功后可在"我的预约"中查看预约码</text>
    </view>
    <view class="notice-item">
      <text class="notice-dot">•</text>
      <text class="notice-text">每人每场限预约 1 次，最多可改签 1 次</text>
    </view>
    <view class="notice-item">
      <text class="notice-dot">•</text>
      <text class="notice-text">请提前 15 分钟到达现场核销入场</text>
    </view>
    <view class="notice-item">
      <text class="notice-dot">•</text>
      <text class="notice-text">如遇天气原因停运，将统一发送通知</text>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-btn {{!phone || phone.length !== 11 ? 'disabled' : ''}}" bindtap="onSubmit">
    <text>确认预约</text>
  </view>
</view>
