<!-- 溪降预约 - 我的预约 -->
<view class="container">
  <!-- 预约列表 -->
  <view class="booking-list" wx:if="{{bookings.length > 0}}">
    <view class="booking-card" wx:for="{{bookings}}" wx:key="_id">
      <!-- 状态标签 -->
      <view class="status-badge {{item.status}}">
        <text>{{getStatusText(item.status)}}</text>
      </view>

      <!-- 预约码 -->
      <view class="code-section" wx:if="{{item.status === 'reserved'}}">
        <text class="code-label">预约码</text>
        <text class="code-value">{{item.code}}</text>
      </view>

      <!-- 场次信息 -->
      <view class="session-info" wx:if="{{item.session}}">
        <view class="info-row">
          <text class="info-label">日期</text>
          <text class="info-value">{{formatDate(item.session.date)}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">时间</text>
          <text class="info-value">{{item.session.startTime}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">票号</text>
          <text class="info-value">{{item.ticketNo}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">手机号</text>
          <text class="info-value">{{item.phone}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="action-buttons" wx:if="{{item.status === 'reserved'}}">
        <view class="action-btn change" bindtap="onChange" data-id="{{item._id}}" wx:if="{{item.changeCount === 0}}">
          <text>改签</text>
        </view>
        <view class="action-btn cancel" bindtap="onCancel" data-id="{{item._id}}">
          <text>取消预约</text>
        </view>
      </view>

      <!-- 已核销信息 -->
      <view class="verified-info" wx:if="{{item.status === 'verified'}}">
        <text class="verified-text">已核销</text>
      </view>

      <!-- 已取消信息 -->
      <view class="cancelled-info" wx:if="{{item.status === 'cancelled'}}">
        <text class="cancelled-text">已取消</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-text">暂无预约记录</text>
    <view class="go-booking-btn" bindtap="goToBooking">
      <text>立即预约</text>
    </view>
  </view>

  <!-- 核销二维码弹层 -->
  <view wx:if="{{showQr}}" class="qr-mask" bindtap="closeQr">
    <view class="qr-panel" catchtap="noop">
      <text class="qr-panel__title">出示给检票员核销</text>
      <canvas wx:if="{{!qrFallback}}" type="2d" id="bookingQr" class="qr-panel__canvas"></canvas>
      <view wx:else class="qr-panel__fallback">{{qrTicket}}</view>
      <text class="qr-panel__code">预约码 {{qrCode}}</text>
      <text class="qr-panel__tip">扫码，或向检票员报预约码</text>
    </view>
  </view>
</view>
