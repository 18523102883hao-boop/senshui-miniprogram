/* 溪降预约 - 我的预约 */
.container {
  padding: 20rpx;
  background-color: #F5F1E9;
  min-height: 100vh;
}

/* 预约卡片 */
.booking-card {
  background: #FAF6EE;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

/* 状态标签 */
.status-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.status-badge.reserved {
  background: #E8F5E9;
  color: #3A6B4F;
}

.status-badge.verified {
  background: #E3F2FD;
  color: #1976D2;
}

.status-badge.cancelled {
  background: #F5F5F5;
  color: #9E9E9E;
}

.status-badge.noshow {
  background: #FFEBEE;
  color: #B23A2E;
}

/* 预约码区域 */
.code-section {
  background: #2A4D3A;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.code-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-bottom: 16rpx;
}

.code-value {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
  letter-spacing: 8rpx;
}

/* 场次信息 */
.session-info {
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #8A8072;
}

.info-value {
  font-size: 28rpx;
  color: #2B2B2B;
  font-weight: 500;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #E8E3D8;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.action-btn.change {
  background: #E8F5E9;
  color: #3A6B4F;
}

.action-btn.cancel {
  background: #FFEBEE;
  color: #B23A2E;
}

/* 已核销/已取消信息 */
.verified-info,
.cancelled-info {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #E8E3D8;
  text-align: center;
}

.verified-text {
  font-size: 28rpx;
  color: #1976D2;
}

.cancelled-text {
  font-size: 28rpx;
  color: #9E9E9E;
}

/* 空状态 */
.empty-state {
  padding: 200rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #8A8072;
  display: block;
  margin-bottom: 40rpx;
}

.go-booking-btn {
  display: inline-block;
  background: #2A4D3A;
  color: white;
  padding: 20rpx 60rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
}
