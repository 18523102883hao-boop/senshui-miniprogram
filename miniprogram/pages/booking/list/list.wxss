.date-picker-card {
  margin-bottom: 24rpx;
}

.sec-head {
  display: flex;
  align-items: center;
}

.sec-head__bar {
  width: 6rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: var(--sr-seal);
  margin-right: 14rpx;
}

.sec-head__icon {
  opacity: 0.8;
}

.date-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--sr-bg-sunken);
  border-radius: var(--sr-radius-sm);
}

.date-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--sr-text);
}

.date-arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.6;
}

.session-list {
  margin-bottom: 24rpx;
}

.session-card {
  margin-bottom: 20rpx;
}

.session-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.session-time-wrapper {
  display: flex;
  align-items: center;
}

.session-time-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  opacity: 0.8;
}

.session-time {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--sr-primary);
}

.session-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 50rpx;
  font-weight: 600;
}

.status-open {
  color: var(--sr-primary);
  background: var(--sr-bg-sunken);
}

.status-closed {
  color: var(--sr-seal);
  background: rgba(240, 112, 85, 0.1);
}

.session-divider {
  height: 1rpx;
  background: var(--sr-line);
  margin: 24rpx 0;
}

.session-body {
  display: flex;
  justify-content: space-around;
}

.session-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.info-label {
  font-size: 24rpx;
  color: var(--sr-text-weak);
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--sr-text);
}

.info-value.warning {
  color: var(--sr-seal);
}

.session-footer {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--sr-line);
}

.session-note-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  opacity: 0.8;
}

.session-note {
  font-size: 24rpx;
  color: var(--sr-seal);
}

.empty-state {
  padding: 100rpx 0;
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.3;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--sr-text-weak);
}

.footer-btn-wrapper {
  padding-top: 8rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
