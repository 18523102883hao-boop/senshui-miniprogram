/* 园区 Tab：按园内使用频次排布
   营业时间 → 地图 → 现场服务 → 园区活动 → 到园求助（业主 2026-07-26 定） */

/* ===== 今日营业（营地与溪降时间不同，分列展示）===== */
.hours {
  display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;
  background: var(--sr-bg-card); border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow); padding: 24rpx 28rpx; margin-bottom: 12rpx;
}
.hours__date { font-size: 30rpx; font-weight: 700; color: var(--sr-text); }
.hours__list { display: flex; }
.hours__item {
  font-size: 21rpx; color: var(--sr-text-sub); background: var(--sr-bg-sunken);
  border-radius: 8rpx; padding: 6rpx 14rpx; margin-left: 10rpx;
}
.hours__item.is-open { background: rgba(54,182,106,0.14); color: #2E9E5B; font-weight: 600; }
.hours__item.is-partial { background: rgba(213,164,58,0.16); color: #A67C1F; font-weight: 600; }
.hours__note {
  display: block; font-size: 20rpx; color: var(--sr-text-weak);
  margin: 0 4rpx 28rpx; 
}

/* ===== 园区活动（只列名称，时间以现场为准）===== */
.acts {
  background: var(--sr-bg-card); border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow); padding: 24rpx 28rpx; margin-bottom: 32rpx;
}
/* 提示条排在列表之前且用暖色底：客人必须先看到「时间以现场为准」再看玩法，
   否则又会把这里当成时刻表 */
.acts__notice {
  display: flex; align-items: flex-start;
  background: rgba(213,164,58,0.14); border-radius: var(--sr-radius-xs);
  padding: 18rpx 20rpx; margin-bottom: 8rpx;
}
.acts__notice-text {
  flex: 1; margin-left: 12rpx;
  font-size: 23rpx; line-height: 1.5; font-weight: 600; color: #8A6410;
}
.acts__list { padding-top: 8rpx; }
.acts__item { display: flex; align-items: center; padding: 18rpx 4rpx; border-bottom: 1rpx solid var(--sr-line); }
.acts__item:last-child { border-bottom: none; }
.acts__dot {
  width: 10rpx; height: 10rpx; border-radius: 50%; flex-shrink: 0;
  background: var(--sr-primary); margin-right: 18rpx;
}
.acts__name { font-size: 27rpx; font-weight: 600; color: var(--sr-text); }


/* ===== 2. 园区地图 ===== */
.maps { display: flex; justify-content: space-between; margin-bottom: var(--sr-gap-5); }
.mapc { width: 48.5%; border-radius: var(--sr-radius); overflow: hidden; position: relative;
  background: var(--sr-bg-sunken); box-shadow: var(--sr-shadow); }
.mapc__img { width: 100%; height: 300rpx; display: block; }
.mapc__label {
  position: absolute; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  font-size: 24rpx; color: #fff; padding: 14rpx 0;
  background: linear-gradient(transparent, rgba(23,54,40,0.78));
}
.mapc__label text { color: #fff; }

/* ===== 3. 现场服务 ===== */
.svc-grid { display: flex; flex-direction: column; margin-bottom: var(--sr-gap-5); }
.svc { display: flex; align-items: center;
  background: var(--sr-bg-card); border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow); padding: 26rpx 32rpx; margin-bottom: 16rpx; }
.svc__iconbox { width: 76rpx; height: 76rpx; border-radius: 50%; background: var(--sr-primary-weak);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.svc__icon { width: 42rpx; height: 42rpx; }
.svc__body { flex: 1; margin-left: 22rpx; min-width: 0; }
.svc__title { display: block; font-size: 29rpx; font-weight: 600; color: var(--sr-text); }
.svc__desc { display: block; font-size: 22rpx; color: var(--sr-text-sub); margin-top: 6rpx; }

/* ===== 4. 到园与求助 ===== */
.help { display: flex; justify-content: space-between; margin-bottom: var(--sr-gap-4); }
.help__btn {
  width: 48.5%; box-sizing: border-box;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: var(--sr-bg-card); border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow); padding: 26rpx 16rpx;
  font-size: 23rpx; color: var(--sr-primary); font-weight: 600;
}
.help__btn text { margin-top: 10rpx; text-align: center; }

/* ===== 全屏地图查看 ===== */
.map-viewer { position: fixed; inset: 0; z-index: 200; background: rgba(10,14,12,0.96); }
.mv-area { width: 100vw; height: 100vh; overflow: hidden; }
.mv-view { display: flex; }
.mv-hint { position: fixed; bottom: calc(48rpx + env(safe-area-inset-bottom)); left: 0; right: 0;
  text-align: center; color: rgba(255,255,255,0.7); font-size: 22rpx; }
.map-viewer__close { position: fixed; top: calc(24rpx + env(safe-area-inset-top)); right: 32rpx;
  width: 72rpx; height: 72rpx; border-radius: 50%; background: rgba(0,0,0,0.5);
  display: flex; align-items: center; justify-content: center; z-index: 1; }
