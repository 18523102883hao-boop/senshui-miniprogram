/* 双主题 tabBar：高不透明度底色为降级基线，backdrop-filter 为渐进增强 */
.bar {
  display: flex;
  padding: 12rpx 0 calc(12rpx + env(safe-area-inset-bottom));
  transition: background-color 0.28s ease;
}
.bar--light {
  background: rgba(246, 244, 240, 0.94);
  backdrop-filter: blur(24rpx);
  border-top: 1rpx solid rgba(36, 75, 54, 0.08);
}
.bar--dark {
  background: rgba(18, 18, 18, 0.90);
  backdrop-filter: blur(24rpx);
  border-top: 1rpx solid rgba(247, 243, 234, 0.08);
}

.item {
  flex: 1;
  display: flex; flex-direction: column; align-items: center;
  padding: 8rpx 0 4rpx;
}
.item__icon {
  width: 52rpx; height: 52rpx;
  transform: scale(0.92);
  opacity: 0.62;
  transition: transform 0.24s ease, opacity 0.24s ease;
}
.item__icon.is-on { transform: scale(1); opacity: 1; }

.item__label {
  font-size: 20rpx; margin-top: 6rpx;
  color: #8B938E; font-weight: 500;
  opacity: 0.8;
  transition: color 0.24s ease, opacity 0.24s ease;
}
.item__label.is-on { opacity: 1; font-weight: 700; }
.bar--light .item__label.is-on { color: #244B36; }
.bar--dark .item__label { color: #969B98; }
.bar--dark .item__label.is-on { color: #D5A43A; }
