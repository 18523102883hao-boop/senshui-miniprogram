/* ============================================================
   森水长河 · 设计系统 Token（Vibe UI v2.0 · 严格对齐根目录 STYLE.md）
   浅色：自然米白 + 森林绿 + 珊瑚CTA + 山野金（金仅用于令/奖励/会员）
   深色：长河令沉浸页专用
   ⚠️ 不得在页面 wxss 里新增色值/圆角/阴影，一律引用这里的变量。
   ============================================================ */
page {
  /* ---- 浅色主题（STYLE.md §4）---- */
  --sr-bg: #F6F4F0;             /* 页面背景 */
  --sr-bg-card: #FFFFFF;        /* 主要表面 */
  --sr-bg-sunken: #EEEDE7;      /* 柔和表面 */
  /* 主色 */
  --sr-primary: #244B36;        /* 品牌绿 */
  --sr-primary-deep: #173628;   /* 深森林绿 */
  --sr-primary-light: #4F7963;  /* 河川绿 */
  --sr-primary-weak: #E9EEE8;   /* 品牌绿弱背景（标签/图标底） */
  /* 强调：珊瑚仅用于交易 CTA / 错误 / 强提醒 */
  --sr-seal: #F07055;
  --sr-seal-light: #F08A73;
  /* 辅助：山野金仅用于长河令 / 奖励 / 会员 / 关键资产 */
  --sr-gold: #D5A43A;
  --sr-gold-light: #E0B95C;
  /* 文字 */
  --sr-text: #172019;           /* 主文字 */
  --sr-text-sub: #667069;       /* 次文字（v2.0 提高对比度） */
  --sr-text-weak: #8B938E;      /* 三级文字 */
  --sr-text-invert: #F7F3EA;
  /* 描边 / 分隔 */
  --sr-border: #E9EEE8;
  --sr-line: rgba(36, 75, 54, 0.10);
  /* 状态 */
  --sr-success: #36B66A;
  --sr-warning: #D5A43A;
  --sr-danger: #F07055;

  /* ---- 长河令深色主题（STYLE.md §4）---- */
  --sr-dark-bg: #101512;        /* 页面背景 */
  --sr-dark-card: #18201B;      /* 卡片背景 */
  --sr-dark-card-2: #202A23;    /* 次级卡片 */
  --sr-dark-text: #F7F3EA;      /* 主文字 */
  --sr-dark-muted: rgba(247, 243, 234, 0.62); /* 次文字 */
  --sr-dark-line: rgba(255, 255, 255, 0.08);

  /* ---- 圆角（STYLE.md §6）---- */
  --sr-radius-xs: 20rpx;        /* 小控件 */
  --sr-radius-sm: 24rpx;        /* 状态标签 */
  --sr-radius: 32rpx;           /* 普通卡片 */
  --sr-radius-lg: 48rpx;        /* 主要卡片 */
  --sr-radius-xl: 64rpx;        /* 沉浸资产卡 */
  /* ---- 间距（8rpx 网格）---- */
  --sr-gap-1: 8rpx;  --sr-gap-2: 16rpx; --sr-gap-3: 24rpx;
  --sr-gap-4: 32rpx; --sr-gap-5: 40rpx; --sr-gap-6: 48rpx; --sr-gap-8: 64rpx;
  /* ---- 动效时长（STYLE.md §7）---- */
  --sr-dur-fast: 140ms;         /* 快速反馈 120-160 */
  --sr-dur-switch: 220ms;       /* 普通切换 200-240 */
  --sr-dur-enter: 300ms;        /* 页面进入 280-340 */
  --sr-dur-sheet: 330ms;        /* 底部弹层 300-360 */
  --sr-ease: cubic-bezier(0.22, 0.61, 0.36, 1);

  --sr-shadow: 0 12rpx 40rpx rgba(30, 55, 40, 0.06);

  background: var(--sr-bg);
  color: var(--sr-text);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 数字统一等宽，避免跳动（STYLE.md §5） */
.sr-num { font-variant-numeric: tabular-nums; font-feature-settings: "tnum"; }

/* ---------- 通用布局类 ---------- */
.sr-page { min-height: 100vh; padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
/* tab 页：自定义 tabBar 浮于页面上，需为其留出底部空间避免遮挡内容 */
.sr-page--tab { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.sr-card {
  background: var(--sr-bg-card);
  border-radius: var(--sr-radius);
  box-shadow: var(--sr-shadow);
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.sr-row { display: flex; align-items: center; }
.sr-row-between { display: flex; align-items: center; justify-content: space-between; }
.sr-col { display: flex; flex-direction: column; }
.sr-fill { flex: 1; }

/* ---------- 文字类 ---------- */
.sr-title { font-size: 48rpx; font-weight: 700; color: var(--sr-primary); letter-spacing: 2rpx; }
.sr-subtitle { font-size: 32rpx; font-weight: 650; color: var(--sr-text); }
.sr-text { font-size: 28rpx; color: var(--sr-text); }
.sr-text-sub { font-size: 26rpx; color: var(--sr-text-sub); }
.sr-text-weak { font-size: 24rpx; color: var(--sr-text-weak); }
.sr-seal-text { color: var(--sr-seal); font-weight: 700; }

/* ---------- 按钮类 ---------- */
.sr-btn {
  display: flex; align-items: center; justify-content: center;
  height: 88rpx; border-radius: 44rpx; font-size: 30rpx; font-weight: 600;
  background: var(--sr-primary); color: var(--sr-text-invert);
  border: none;
  transition: transform 0.12s ease-out, filter 0.12s ease-out;
}
.sr-btn::after { border: none; }
.sr-btn--seal { background: var(--sr-seal); }
.sr-btn--ghost { background: transparent; color: var(--sr-primary); border: 2rpx solid var(--sr-primary); }
.sr-btn--disabled { background: var(--sr-bg-sunken); color: var(--sr-text-weak); }

/* ---------- 徽章 / 分隔 ---------- */
.sr-badge {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 4rpx 16rpx; border-radius: 12rpx; font-size: 22rpx;
  background: var(--sr-seal); color: #fff;
}
.sr-divider { height: 1rpx; background: var(--sr-line); margin: 24rpx 0; }

/* ---------- 按压态（整卡可点击 · hover-class 方案）----------
   STYLE.md §7 三档，按元素面积区分，大卡不得用重档否则页面抖动：
     大卡片   hover-class="sr-touch--card"  scale(.985)
     普通入口 hover-class="sr-touch--press" scale(.97)
     主 CTA   hover-class="sr-touch--cta"   scale(.96)
   用法：class="sr-card sr-touch" hover-class="sr-touch--card" hover-stay-time="60" */
.sr-touch { transition: transform var(--sr-dur-fast) var(--sr-ease), filter var(--sr-dur-fast) var(--sr-ease); }
.sr-touch--card { transform: scale(0.985); }
.sr-touch--press { transform: scale(0.97); }
.sr-touch--cta { transform: scale(0.96); filter: brightness(0.96); }

/* ---------- 图标 ---------- */
.sr-icon { width: 44rpx; height: 44rpx; }
.sr-icon--lg { width: 56rpx; height: 56rpx; }
.sr-icon--sm { width: 32rpx; height: 32rpx; }

/* ---------- 深色主题（长河令沉浸页）---------- */
.sr-dark-card {
  background: var(--sr-dark-card);
  border-radius: var(--sr-radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
}
/* 弥散光资产卡：两个绝对定位 radial-gradient 光层（不依赖伪元素） */
.sr-glow-card {
  background: var(--sr-dark-card);
  border-radius: var(--sr-radius-xl);
  position: relative; overflow: hidden;
}
.sr-glow-a {
  position: absolute; width: 460rpx; height: 460rpx; right: -140rpx; top: -180rpx;
  background: radial-gradient(circle, rgba(213, 164, 58, 0.20) 0%, rgba(213, 164, 58, 0) 65%);
  pointer-events: none;
}
.sr-glow-b {
  position: absolute; width: 520rpx; height: 520rpx; left: -180rpx; bottom: -240rpx;
  background: radial-gradient(circle, rgba(58, 103, 73, 0.32) 0%, rgba(58, 103, 73, 0) 65%);
  pointer-events: none;
}

/* ---------- 黑金会员卡（浅色区可复用，含流光反光）---------- */
.sr-goldcard {
  background: linear-gradient(135deg, #102016 0%, #244B36 55%, #173628 100%);
  position: relative; overflow: hidden;
}
/* 流光用 ::before：伪元素绘制在子内容之下，无需通配选择器提升层级（WXSS 不支持 *） */
.sr-goldcard::before {
  content: ''; position: absolute; top: 0; left: -120%;
  width: 55%; height: 100%; pointer-events: none;
  background: linear-gradient(100deg, rgba(255,255,255,0) 0%, rgba(213,164,58,0.16) 50%, rgba(255,255,255,0) 100%);
  transform: skewX(-22deg); animation: sr-shine 5s ease-in-out infinite;
}
@keyframes sr-shine { 0% { left: -120%; } 30% { left: 220%; } 100% { left: 220%; } }
.sr-gold-hairline { border: 1rpx solid rgba(213, 164, 58, 0.30); }

/* ---------- 页面进入动效（transform/opacity only）---------- */
.sr-enter { animation: sr-enter 0.34s cubic-bezier(0.16, 1, 0.3, 1) both; }
@keyframes sr-enter {
  from { opacity: 0; transform: translateY(16rpx) scale(0.985); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
